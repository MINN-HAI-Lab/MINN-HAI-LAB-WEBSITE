---
/**
 * The page shell. Every page uses this.
 *
 * Document outline: the skip link targets #main, which is the <main> landmark.
 * Pages supply exactly one <h1> in the default slot and headings descend from
 * there without skipping a level — CLAUDE.md requires that and T-25 checks it.
 */
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { LAB_NAME } from '../data/navigation.ts';
import '../styles/global.css';

interface Props {
  /** Goes in <title>. Sentence case, like everything else. */
  title: string;
  /** Meta description. Optional — omitted rather than filled with filler. */
  description?: string;
  /**
   * Keep this page out of search results. For working documents like the type
   * specimen, which exist for whoever is building the site rather than for
   * anyone reading it.
   */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

/**
 * No canonical URL, and no absolute URLs anywhere.
 *
 * They need an origin, the domain is undecided (open question 10 in
 * design/decisions.md, and D-008 ties hosting to it), and a placeholder domain
 * baked into production metadata is exactly the kind of plausible-looking
 * fabrication CLAUDE.md is about. Relative metadata is correct at any origin;
 * canonical, Open Graph URLs and the sitemap all wait for the real one.
 */---
---

<!doctype html>
<!-- en-GB because decisions.md records that the site uses British spellings.
     The lab's own name may keep an American spelling; that is B-1. -->
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, follow" />}

    {/* SVG only. It scales to every size a browser asks for, and an .ico would
        mean checking in a rasterised copy that could drift from the tokens. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Open Graph, minus anything needing an origin.

        og:url and og:image both have to be absolute, and there is no domain
        yet (Q-13). A share image is generated at /share.svg and is not
        referenced here, because a relative og:image is silently ignored by
        every crawler and a made-up domain is worse than none. Both become one
        line each when the domain lands — Q-14. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={LAB_NAME} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <Font cssVariable="--font-literata" preload />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <Header />

    {/* tabindex="-1" so the skip link genuinely moves focus here.

        Without it, activating a fragment link scrolls the page and updates the
        sequential focus starting point, but leaves document.activeElement on
        the body in several browsers — so the next Tab goes back to the top and
        the skip link skips nothing. It is -1, not 0, so it never becomes a tab
        stop of its own. */}
    <main id="main" class="page" tabindex="-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
