---
/**
 * The page shell.
 *
 * Document outline: the skip link targets #main, which is the <main>
 * landmark. Pages supply exactly one <h1> and headings descend without
 * skipping a level.
 */
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { LAB_NAME } from '../data/navigation.ts';
import { withBase } from '../lib/paths.ts';
import '../styles/global.css';

interface Props {
  /** Goes in <title>. Sentence case, like everything else. */
  title: string;
  /** Meta description. Omitted rather than filled with filler. */
  description?: string;
  /** Keep this page out of search results. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

/**
 * Absolute URLs, but only when there is a real origin to build them from.
 *
 * `Astro.site` is set from the SITE_URL environment variable at build time and
 * is undefined without it (B-8). A placeholder domain baked into production
 * metadata is exactly the kind of plausible-looking fabrication that survives
 * review because it looks right — so when there is no origin, these tags are
 * absent rather than wrong.
 *
 * Supply the domain and the canonical URL, og:url and an absolute share image
 * all appear together, with no further edit here.
 */
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const shareImage = Astro.site ? new URL(withBase('/share.svg'), Astro.site).href : null;
---

<!doctype html>
<!-- en-GB: decisions.md records that the site uses British spellings. The
     lab's own name may keep an American one; that is B-1. -->
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- The page is dark before a single byte of CSS arrives, so there is no
         white flash on a slow connection. -->
    <meta name="theme-color" content="#070b10" />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- No preload. Astro inlines the @font-face rules into this head, so the
         font is discovered while parsing it and there is no stylesheet round
         trip for a preload to save. What preload does do is defeat
         unicode-range and pull down a latin-ext subset no page here uses:
         measured at 152.8KB with it against 83.8KB without. -->
    <Font cssVariable="--font-literata" />
    <!-- Both faces, or the grotesk's variable is never declared and every
         label quietly falls back to the system sans — which is exactly what
         happened on the first build of the redesign, and what the weight spec
         caught by counting one font file where there should be two. -->
    <Font cssVariable="--font-space-grotesk" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={LAB_NAME} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {shareImage && <meta property="og:image" content={shareImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {shareImage && <meta name="twitter:image" content={shareImage} />}

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <Header />

    <!-- tabindex="-1" so the skip link genuinely moves focus here. Without it
         the browser scrolls and updates the sequential focus starting point
         but leaves activeElement on the body, so the next Tab returns to the
         header and the link skips nothing. -->
    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <script>
      /**
       * One entrance reveal per section, once, never repeating.
       *
       * The hidden state is added here rather than in CSS, so with JavaScript
       * off nothing is hidden and there is nothing that could fail to be
       * revealed. Under reduced motion it is never added at all — the section
       * resolves to its finished state rather than to a zero-duration
       * transform, which would be a jump rather than the absence of one.
       */
      const targets = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (targets.length > 0 && !still && 'IntersectionObserver' in window) {
        for (const el of targets) el.classList.add('is-pending');

        const reveal = (el: Element): void => {
          el.classList.remove('is-pending');
          el.classList.add('is-revealed');
        };

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              reveal(entry.target);
              // Stop watching immediately: the reveal happens once and must
              // not replay on the way back up.
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
        );

        for (const el of targets) observer.observe(el);

        /* Safety net. The whole point of applying the hidden state from script
           is that nothing is hidden unless something can un-hide it — but that
           still leaves the case where the observer exists and never fires. A
           reader who lands deep-linked, or on a browser where the observer
           misbehaves, would be looking at blank sections.

           So after four seconds anything still pending is revealed regardless.
           By then a reader who was going to scroll has scrolled; anything left
           reveals off-screen, which costs nothing and cannot be seen. */
        window.setTimeout(() => {
          for (const el of targets) {
            if (!el.classList.contains('is-pending')) continue;
            reveal(el);
            observer.unobserve(el);
          }
        }, 4000);
      }
    </script>
  </body>
</html>
