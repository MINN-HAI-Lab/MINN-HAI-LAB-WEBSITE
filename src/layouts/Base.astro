---
/**
 * The page shell. Every page uses this.
 *
 * Document outline: the skip link targets #main, which is the <main> landmark.
 * Pages supply exactly one <h1> in the default slot and headings descend from
 * there without skipping a level — CLAUDE.md requires that and T-25 checks it.
 */
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props {
  /** Goes in <title>. Sentence case, like everything else. */
  title: string;
  /** Meta description. Optional — omitted rather than filled with filler. */
  description?: string;
  /**
   * Keep this page out of search results. For working documents like the type
   * specimen, which exist for whoever is building the site rather than for
   * anyone reading it.
   */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

/**
 * No canonical URL, and no absolute URLs anywhere.
 *
 * They need an origin, the domain is undecided (open question 10 in
 * design/decisions.md, and D-008 ties hosting to it), and a placeholder domain
 * baked into production metadata is exactly the kind of plausible-looking
 * fabrication CLAUDE.md is about. Relative metadata is correct at any origin;
 * canonical, Open Graph URLs and the sitemap all wait for the real one.
 */---
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <Font cssVariable="--font-literata" preload />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <Header />

    <main id="main" class="page">
      <slot />
    </main>

    <Footer />
  </body>
</html>
