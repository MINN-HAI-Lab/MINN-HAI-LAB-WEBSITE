---
/**
 * The publication list.
 *
 * Dense rows, not cards: fourteen entries in cards is unreadable and this list
 * grows. Every field comes from src/data/publications.ts and nothing is
 * rendered that is not in it.
 *
 * Authors and links are missing from the supplied list, and every row is
 * missing them in the same way. The first version printed the whole TODO under
 * each row, which meant the same four lines fourteen times: on /research that
 * was thirty-seven repetitions of one sentence, and it buried the papers it
 * was annotating. The gap is now stated once above the list, and each row
 * carries a short marker so it is still visible per entry rather than only in
 * aggregate.
 */
import type { Publication } from '../data/publications.ts';

interface Props {
  publications: readonly Publication[];
}

const { publications } = Astro.props;

/** How many of these rows are still missing their authors or their link. */
const incomplete = publications.filter((p) => p.authors === null || p.paperUrl === null).length;
---

{
  incomplete > 0 && (
    <p class="todo measure">
      TODO: authors and paper links for{' '}
      {incomplete === publications.length
        ? publications.length === 1 ? 'this entry' : 'every entry here'
        : `${incomplete} of these entries`}. The supplied list has
      short names, venues and years only, and a plausible-looking author list or
      DOI is the worst thing this site could ship — it would not look wrong to a
      reader. Kaung to supply. Tracked as B-4.
    </p>
  )
}

<ol class="publications">
  {
    publications.map((publication) => (
      <li class="publications__row">
        <span class="publications__year readout tnum">{publication.year}</span>
        <span class="publications__body">
          <span class="publications__name">{publication.shortName}</span>
          <span class="publications__meta label">
            {publication.venue}
            {publication.hasCode && <span class="publications__flag">code</span>}
            {(publication.authors === null || publication.paperUrl === null) && (
              <span class="publications__gap">authors and link not supplied</span>
            )}
          </span>
          {publication.note && <span class="publications__note label">{publication.note}</span>}
        </span>
      </li>
    ))
  }
</ol>
