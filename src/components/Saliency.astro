---
/**
 * Artefact 3 — computer vision.
 *
 * A saliency map over a photograph. Move the cursor and the map follows: the
 * model attends to structure, but only near where it is currently looking.
 *
 * Both halves are real. The photograph is openly licensed — CC0, verified
 * against the Wikimedia Commons API rather than assumed — and the map over it
 * is a Sobel gradient computed in the browser from that photograph's own
 * pixels. The only invented thing is the fixation point, and that is the
 * reader's cursor.
 *
 * With JavaScript off the photograph is still there, with real alt text and
 * the explanation beneath it. The image is the base layer, not something the
 * script draws, which is why that degradation costs nothing.
 */
import { Image } from 'astro:assets';
import subject from '../assets/attention-subject.jpg';

const alt =
  'Close-up photograph of a tabby cat facing the camera. Its two pale blue ' +
  'eyes, the striped fur on its forehead and its whiskers are sharply in ' +
  'focus; the background behind it is thrown completely out of focus into ' +
  'smooth bands of orange and brown.';
---

<figure class="artefact saliency" data-saliency>
  <div class="artefact__bar">
    <p class="artefact__name">Computer vision</p>
    <p class="artefact__provenance">Openly licensed photograph, computed saliency</p>
  </div>

  <div class="artefact__panel glass">
    <div class="saliency__stage" data-stage>
      <Image
        class="saliency__photo"
        src={subject}
        alt={alt}
        widths={[400, 600, 900]}
        sizes="(min-width: 900px) 600px, 92vw"
        loading="lazy"
        data-photo
      />

      <!-- Painted by script from the photograph above it. Sized in JS to the
           working resolution, scaled up by CSS. -->
      <canvas class="saliency__map" data-map-canvas aria-hidden="true"></canvas>
    </div>

    <p class="saliency__fallback label" data-fallback>
      The saliency map over this photograph needs JavaScript to compute. What it
      shows: attention concentrates where the image has structure — the eyes,
      the whiskers, the edge of the fur — and falls away across the smooth
      background, even right next to where the model is looking.
    </p>
  </div>

  <ul class="saliency__key" data-key hidden>
    <li class="saliency__key-item label">
      <span class="saliency__ramp" aria-hidden="true"></span>
      <span>Low to high attention</span>
    </li>
    <li class="saliency__key-item label">
      <span class="readout readout--signal tnum" data-peak>—</span>
      <span data-peak-label>peak attention under the pointer</span>
    </li>
  </ul>

  <div class="artefact__controls" data-controls hidden>
    <button class="button" type="button" data-mode aria-pressed="false">Show every edge</button>
  </div>

  <figcaption class="artefact__caption">
    <p class="visually-hidden" data-live role="status" aria-live="polite"></p>

    <p class="artefact__readout" data-readout>
      Attention concentrates where the image has structure. Move the pointer
      over the photograph, or focus it and use the arrow keys, to move the
      fixation point.
    </p>

    <p class="artefact__note" data-provenance-note>
      Real photograph, real computation. The map is the gradient magnitude of
      this image's own pixels — a Sobel edge response, computed in your browser
      — gated by distance from the fixation point. The colour ramp is viridis,
      which is perceptually uniform and still reads in greyscale.
      Photograph:{' '}
      <a class="link" href="https://commons.wikimedia.org/wiki/File:Tabby_cat_with_blue_eyes-3336579.jpg" rel="noopener">Tabby cat with blue eyes</a>{' '}
      by AdinaVoicu, via Wikimedia Commons, released under{' '}
      <a class="link" href="https://creativecommons.org/publicdomain/zero/1.0/" rel="noopener">CC0 1.0</a>.
    </p>
  </figcaption>
</figure>

<script>
  /**
   * The saliency artefact.
   *
   * The photograph is read back out of the DOM and its pixels are the input,
   * so what a reader sees genuinely follows from the image on screen rather
   * than from anything baked in at build time.
   */
  import { attentionAt, edgeEnergy, gazeAt, ramp } from '../lib/saliency.ts';

  const root = document.querySelector<HTMLElement>('[data-saliency]');

  if (root) {
    const el = root;
    const stage = el.querySelector<HTMLElement>('[data-stage]')!;
    const photo = el.querySelector<HTMLImageElement>('[data-photo]')!;
    const mapCanvas = el.querySelector<HTMLCanvasElement>('[data-map-canvas]')!;
    const fallback = el.querySelector<HTMLElement>('[data-fallback]')!;
    const key = el.querySelector<HTMLElement>('[data-key]')!;
    const controls = el.querySelector<HTMLElement>('[data-controls]')!;
    const peakOut = el.querySelector<HTMLElement>('[data-peak]')!;
    const peakLabel = el.querySelector<HTMLElement>('[data-peak-label]')!;
    const readout = el.querySelector<HTMLElement>('[data-readout]')!;
    const live = el.querySelector<HTMLElement>('[data-live]')!;
    const modeButton = el.querySelector<HTMLButtonElement>('[data-mode]')!;

    /* Working resolution, 3:2 like the photograph. Fixed and modest: the whole
       field is recomputed on every pointer move, so this is the number that
       decides whether the artefact feels immediate or laggy. Upscaled by CSS,
       which is fine — a saliency map is a smooth field, not fine detail. */
    const W = 300;
    const H = 200;
    /** Gaussian width of the fixation, in working pixels. */
    const FALLOFF = 46;

    const mapCtx = mapCanvas.getContext('2d');
    if (!mapCtx) throw new Error('2D canvas is unavailable');
    const paint = mapCtx;

    mapCanvas.width = W;
    mapCanvas.height = H;

    let energy: Float32Array | null = null;
    let fixation = { x: W * 0.62, y: H * 0.52 };
    let everyEdge = false;
    let queued = 0;

    const mapImage = paint.createImageData(W, H);

    /** Read the photograph's pixels once, at the working resolution. */
    function measurePhoto(): void {
      const work = document.createElement('canvas');
      work.width = W;
      work.height = H;
      const ctx = work.getContext('2d', { willReadFrequently: true });
      if (!ctx) return;
      ctx.drawImage(photo, 0, 0, W, H);
      energy = edgeEnergy(ctx.getImageData(0, 0, W, H).data, W, H);
    }

    function draw(): void {
      if (!energy) return;

      const gaze = everyEdge ? null : gazeAt(W, H, fixation.x, fixation.y, FALLOFF);
      const field = gaze ? attentionAt(energy, gaze) : energy;

      let peak = 0;
      for (let i = 0; i < field.length; i += 1) {
        const value = field[i]!;
        if (value > peak) peak = value;

        /* Two overlays composited into one canvas: a black veil that dims the
           periphery, and the heat itself. Doing it here rather than stacking
           two canvases keeps the artefact to one extra layer over the photo,
           which matters when the panel behind it is already a glass surface. */
        const heat = Math.min(1, value * 2.2) * 0.95;
        const veil = gaze ? 0.82 * (1 - gaze[i]!) : 0;
        const total = heat + veil * (1 - heat);

        const [r, g, b] = ramp(Math.min(1, value * 1.6));
        const p = i * 4;
        // The heat sits over the veil, so the visible colour is the heat's own
        // scaled by how much of the total opacity it accounts for.
        const share = total > 0 ? heat / total : 0;
        mapImage.data[p] = Math.round(r * share);
        mapImage.data[p + 1] = Math.round(g * share);
        mapImage.data[p + 2] = Math.round(b * share);
        mapImage.data[p + 3] = Math.round(total * 255);
      }

      paint.putImageData(mapImage, 0, 0);
      peakOut.textContent = peak.toFixed(2);
    }

    /** Coalesce pointer moves to one paint per frame. */
    function schedule(): void {
      if (queued) return;
      queued = requestAnimationFrame(() => {
        queued = 0;
        draw();
      });
    }

    function moveTo(clientX: number, clientY: number): void {
      const rect = stage.getBoundingClientRect();
      fixation = {
        x: ((clientX - rect.left) / rect.width) * W,
        y: ((clientY - rect.top) / rect.height) * H,
      };
      schedule();
    }

    stage.addEventListener('pointermove', (event) => {
      if (everyEdge) return;
      moveTo(event.clientX, event.clientY);
    });

    /* Keyboard parity. A cursor-following artefact that only works with a
       cursor is not operable, so the stage is focusable and the arrow keys
       move the fixation point. */
    stage.tabIndex = 0;
    stage.setAttribute('role', 'application');
    stage.setAttribute(
      'aria-label',
      'Saliency map over a photograph. Arrow keys move the fixation point; hold shift to move further.',
    );

    stage.addEventListener('keydown', (event) => {
      const step = event.shiftKey ? 30 : 10;
      const moves: Record<string, [number, number]> = {
        ArrowLeft: [-step, 0],
        ArrowRight: [step, 0],
        ArrowUp: [0, -step],
        ArrowDown: [0, step],
      };
      const move = moves[event.key];
      if (!move) return;
      event.preventDefault();
      fixation = {
        x: Math.max(0, Math.min(W, fixation.x + move[0]!)),
        y: Math.max(0, Math.min(H, fixation.y + move[1]!)),
      };
      schedule();
      live.textContent = `Fixation at ${Math.round((fixation.x / W) * 100)} per cent across, ${Math.round((fixation.y / H) * 100)} per cent down.`;
    });

    modeButton.addEventListener('click', () => {
      everyEdge = !everyEdge;
      modeButton.setAttribute('aria-pressed', String(everyEdge));
      modeButton.textContent = everyEdge ? 'Follow the pointer again' : 'Show every edge';

      /* The number under the ramp means something different in each mode, so
         it is relabelled rather than left saying "under the pointer" when
         there is no pointer. */
      peakLabel.textContent = everyEdge
        ? 'strongest edge in the photograph'
        : 'peak attention under the pointer';

      readout.textContent = everyEdge
        ? 'Every edge the operator finds, with no fixation point — the whole gradient field at once. The eyes, the whiskers and the rim of each ear come back strongly; the thrown-out background comes back at nearly nothing.'
        : 'Attention concentrates where the image has structure. Move the pointer over the photograph, or focus it and use the arrow keys, to move the fixation point.';

      live.textContent = readout.textContent;
      schedule();
    });

    function start(): void {
      measurePhoto();
      if (!energy) return;
      // The fallback explains what is missing; once it is not missing, it goes.
      fallback.hidden = true;
      key.hidden = false;
      controls.hidden = false;
      el.classList.add('is-live');
      draw();
    }

    /* The image is lazy, so it may not have arrived — or even been requested —
       when this runs. decode() resolves once the pixels are genuinely there,
       which is the only point at which they can be read. */
    if (photo.complete && photo.naturalWidth > 0) start();
    else photo.addEventListener('load', start, { once: true });
  }
</script>
