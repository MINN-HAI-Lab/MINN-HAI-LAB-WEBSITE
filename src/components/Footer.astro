---
/**
 * Site footer.
 *
 * docs/plan.md: "Contact is a line in the footer, not a page."
 *
 * The contact address is a TODO rather than a plausible-looking string. An
 * invented email in a footer is a small lie in the most load-bearing place on
 * an academic site.
 */
import { LAB_NAME } from '../data/navigation.ts';
---

<footer class="site-footer">
  <div class="page site-footer__inner">
    <p class="site-footer__name">{LAB_NAME}</p>

    <p class="todo measure">
      TODO: the contact address for the footer. The plan lists a contact email
      as supplied, but it is not in the repo. Kaung to supply. An invented
      address would be worse than this gap. Tracked as B-9.
    </p>
  </div>
</footer>
