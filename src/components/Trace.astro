---
/**
 * The knowledge trace.
 *
 * This file emits the *static* rendering: real SVG, built at build time, in
 * the HTML, with no client JavaScript. It is what a reader gets with
 * JavaScript off and what everyone sees before hydration, and CLAUDE.md
 * requires it to be "an actual readable rendering of the same data", not a
 * placeholder. The interactive layer is added later (T-10) on top of this
 * exact markup.
 *
 * The data is synthetic and the widget says so on its face.
 */
import { describe, formatPercent, trace } from '../lib/mastery.ts';
import { VIEW, layout, yFor } from '../lib/trace-geometry.ts';
import { EXAMPLE_ATTEMPTS, EXAMPLE_SKILL } from '../data/trace-example.ts';

interface Props {
  /** Sequence to render. Defaults to the synthetic example. */
  attempts?: readonly boolean[];
  /** Skill the sequence is about. */
  skill?: string;
}

const { attempts = EXAMPLE_ATTEMPTS, skill = EXAMPLE_SKILL } = Astro.props;

const result = trace(attempts);
const geometry = layout(result);
const sentence = describe(result, skill);

/** Radius in user units. --mark-size is a diameter. */
const markRadius = 10;

const correctCount = result.steps.filter((step) => step.correct).length;

/**
 * Text alternative. Describes what the drawing shows, not what it is — "a
 * line chart" would tell a screen reader user nothing they can act on.
 */
const altText =
  `Knowledge trace over ${result.steps.length} attempts at ${skill}, ` +
  `${correctCount} correct. The model's estimate starts at ` +
  `${formatPercent(result.initial)} per cent, before any attempt, and ` +
  `ends at ${formatPercent(result.final)} per cent. A shaded band around ` +
  `the line shows the model's uncertainty, which narrows as attempts ` +
  `accumulate.`;
---

<figure
  class="trace"
  data-trace
  data-attempts={JSON.stringify(attempts)}
  data-skill={skill}
>
  <div class="trace__panel">
    <svg
      class="trace__svg"
      viewBox={`0 0 ${VIEW.width} ${VIEW.height}`}
      role="img"
      aria-label={altText}
      preserveAspectRatio="xMidYMid meet"
    >
      <title>Knowledge trace for {skill}</title>

      {/* Baseline. A hairline, decorative, so --rule is the right weight. */}
      <line
        class="trace__axis"
        x1={VIEW.padX}
        y1={yFor(0)}
        x2={VIEW.width - VIEW.padX}
        y2={yFor(0)}
      />

      {/* Axis endpoints. Without them the curve's height means nothing. */}
      <text class="trace__axis-label" x={VIEW.padX - 10} y={yFor(1)} dy="0.32em">1</text>
      <text class="trace__axis-label" x={VIEW.padX - 10} y={yFor(0)} dy="0.32em">0</text>

      {/* Uncertainty band. The fill is a wash at 12% and cannot carry the
          information on its own (1.22:1 against the panel), so the 1px --claim
          edges do it. D-013. */}
      {geometry.bandPath && (
        <>
          <path class="trace__band" d={geometry.bandPath} data-band />
          <path class="trace__band-edge" d={geometry.bandUpperPath} data-band-upper />
          <path class="trace__band-edge" d={geometry.bandLowerPath} data-band-lower />
        </>
      )}

      {/* The estimate itself. The only --claim line on the page. */}
      <path class="trace__curve" d={geometry.curvePath} data-curve />

      {/* Attempts. Shape carries correct/incorrect, not colour, so the trace
          still reads in greyscale and for colour-blind readers. */}
      {/* Rendered inert. The script upgrades each group to a button once it
          runs, so with JavaScript off these stay honest marks rather than
          controls that look live and do nothing. */}
      <g class="trace__marks" data-marks>
        {geometry.marks.map((mark) => (
          <g class="trace__mark-group" data-index={mark.index}>
            {/* A larger transparent disc so the hit area clears the 24px
                minimum without inflating the 20px mark itself. */}
            <circle class="trace__mark-hit" cx={mark.x} cy={mark.y} r={16} />
            <circle
              class:list={['trace__mark', mark.correct ? 'is-correct' : 'is-incorrect']}
              cx={mark.x}
              cy={mark.y}
              r={markRadius}
            />
          </g>
        ))}
      </g>
    </svg>

    {/* Key. "Shape carries the distinction" only holds if a reader can decode
        which shape is which, so the two marks are shown at the size they
        appear, drawn by the same CSS. Nothing here relies on colour: printed
        in greyscale, or seen by a colour-blind reader, it reads the same. */}
    <ul class="trace__key">
      <li class="trace__key-item">
        <svg class="trace__key-swatch" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <circle class="trace__mark is-correct" cx="10" cy="10" r="8" />
        </svg>
        <span>A filled circle is an attempt answered correctly.</span>
      </li>
      <li class="trace__key-item">
        <svg class="trace__key-swatch" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <circle class="trace__mark is-incorrect" cx="10" cy="10" r="8" />
        </svg>
        <span>An open circle is an attempt answered incorrectly.</span>
      </li>
    </ul>

    {/* Hidden until the script runs. With JavaScript off none of this is
        true, and telling a reader to press keys that do nothing is worse than
        saying nothing. */}
    <p class="trace__instructions" data-instructions hidden>
      Select an attempt to change its answer and watch the estimate move. Use
      the arrow keys to move between attempts, then Enter or Space to change
      one.
    </p>
  </div>

  <figcaption class="trace__caption">
    {/* Holds the graphic's description once the SVG stops being an image and
        becomes a group of controls. Empty and off-screen until then, because
        while role="img" is on the SVG the same text is already the alt. */}
    <p class="visually-hidden" data-summary></p>

    {/* Announces the estimate after a toggle.

        Polite, never assertive: this is the result of something the reader
        just did, not an error or an interruption, and assertive would cut off
        whatever the screen reader was already saying.

        Empty in the HTML and populated only by the script. A live region has
        to be in the DOM before its content changes or the change goes
        unannounced, and pre-filling it would make some screen readers read the
        initial state out on page load for no reason. */}
    <p class="visually-hidden" data-live role="status" aria-live="polite"></p>

    <p class="trace__sentence" data-sentence>{sentence}</p>
    <p class="trace__synthetic">
      Synthetic data. This sequence was invented to illustrate the method. It
      is not a recording of a learner and not output from a model trained on
      student data.
    </p>
  </figcaption>
</figure>

<script>
  /**
   * The interactive layer.
   *
   * Progressive enhancement over the static SVG: the markup is already correct
   * and readable before this runs, and everything below only upgrades it. With
   * JavaScript off the marks stay inert, which is why they are not rendered as
   * buttons server-side.
   *
   * Geometry comes from the same layout() the build used, so the interactive
   * trace and the static one cannot disagree about where anything goes.
   */
  import { describe, trace } from '../lib/mastery.ts';
  import { blend, layout } from '../lib/trace-geometry.ts';
  import { EASE_OUT, cubicBezier, durationToMs } from '../lib/easing.ts';

  const root = document.querySelector<SVGElement & HTMLElement>('[data-trace]');

  if (root) {
    const svgRoot = root.querySelector('[data-marks]');
    const band = root.querySelector<SVGPathElement>('[data-band]');
    const bandUpper = root.querySelector<SVGPathElement>('[data-band-upper]');
    const bandLower = root.querySelector<SVGPathElement>('[data-band-lower]');
    const curve = root.querySelector<SVGPathElement>('[data-curve]');
    const sentence = root.querySelector<HTMLElement>('[data-sentence]');
    const groups = [...root.querySelectorAll<SVGGElement>('[data-index]')];

    const skill = root.dataset.skill ?? '';
    let attempts: boolean[] = JSON.parse(root.dataset.attempts ?? '[]');
    let result = trace(attempts);

    /* Motion values are read from the tokens rather than repeated here, so
       DESIGN.md stays the single source. */
    const styles = getComputedStyle(document.documentElement);
    const duration = durationToMs(styles.getPropertyValue('--dur-base'));
    const ease = cubicBezier(EASE_OUT);

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    let frame = 0;

    /** Push one geometry onto the DOM. */
    function paint(at: ReturnType<typeof trace>): void {
      const geometry = layout(at);
      curve?.setAttribute('d', geometry.curvePath);
      band?.setAttribute('d', geometry.bandPath);
      bandUpper?.setAttribute('d', geometry.bandUpperPath);
      bandLower?.setAttribute('d', geometry.bandLowerPath);
    }

    /** Redraw the marks to match the current attempts. */
    function paintMarks(): void {
      for (const group of groups) {
        const index = Number(group.dataset.index);
        const correct = attempts[index] === true;
        const mark = group.querySelector('.trace__mark');
        mark?.classList.toggle('is-correct', correct);
        mark?.classList.toggle('is-incorrect', !correct);
        group.setAttribute('aria-pressed', String(correct));
        group.setAttribute(
          'aria-label',
          `Attempt ${index + 1}, answered ${correct ? 'correctly' : 'incorrectly'}. ` +
            `Activate to mark it ${correct ? 'incorrect' : 'correct'}.`,
        );
      }
    }

    /**
     * Animate from the current estimate to the next one.
     *
     * DESIGN.md: the movement is the information, so it decelerates into the
     * new value with --ease-out over --dur-base. Under reduced motion the
     * value is set outright rather than transitioned at zero duration, which
     * would produce a jump.
     */
    function animateTo(next: ReturnType<typeof trace>): void {
      cancelAnimationFrame(frame);

      if (reduceMotion.matches || duration <= 0) {
        result = next;
        paint(result);
        return;
      }

      const from = result;
      const started = performance.now();

      const step = (now: number): void => {
        const elapsed = now - started;
        const progress = Math.min(elapsed / duration, 1);
        paint(blend(from, next, ease(progress)));
        if (progress < 1) frame = requestAnimationFrame(step);
        else result = next;
      };

      frame = requestAnimationFrame(step);
    }

    const live = root.querySelector<HTMLElement>('[data-live]');
    let announceTimer = 0;

    /**
     * Announce the new estimate, once the dust settles.
     *
     * Held back by the animation duration so that arrowing across several
     * attempts and flipping them in quick succession produces one useful
     * sentence rather than a queue of half-stale ones. The announcement names
     * the attempt that changed, because "99 per cent" on its own does not tell
     * a listener what moved.
     */
    function announce(at: ReturnType<typeof trace>, index: number): void {
      if (!live) return;
      window.clearTimeout(announceTimer);
      const correct = attempts[index] === true;
      const settle = reduceMotion.matches ? 0 : duration;
      announceTimer = window.setTimeout(() => {
        live.textContent =
          `Attempt ${index + 1} is now ${correct ? 'correct' : 'incorrect'}. ` +
          describe(at, skill);
      }, settle);
    }

    /** Flip one attempt and redraw everything that depends on it. */
    function toggle(index: number): void {
      if (!Number.isInteger(index) || index < 0 || index >= attempts.length) return;
      attempts = attempts.map((value, i) => (i === index ? !value : value));
      const next = trace(attempts);
      paintMarks();
      if (sentence) sentence.textContent = describe(next, skill);
      announce(next, index);
      animateTo(next);
    }

    /**
     * Roving tabindex.
     *
     * Ten attempts should cost one Tab stop, not ten. Exactly one mark is in
     * the tab order at a time and the arrow keys move between them, which is
     * the expected behaviour for a composite control and keeps the trace from
     * swamping the page's tab sequence.
     */
    let active = 0;

    function focusMark(next: number, moveFocus = true): void {
      active = Math.max(0, Math.min(next, groups.length - 1));
      groups.forEach((group, i) => {
        group.setAttribute('tabindex', i === active ? '0' : '-1');
      });
      if (moveFocus) groups[active]?.focus();
    }

    function onKeydown(event: KeyboardEvent, index: number): void {
      switch (event.key) {
        case 'ArrowRight':
        case 'ArrowDown':
          event.preventDefault();
          focusMark(index + 1);
          break;
        case 'ArrowLeft':
        case 'ArrowUp':
          event.preventDefault();
          focusMark(index - 1);
          break;
        case 'Home':
          event.preventDefault();
          focusMark(0);
          break;
        case 'End':
          event.preventDefault();
          focusMark(groups.length - 1);
          break;
        case 'Enter':
        case ' ':
        case 'Spacebar':
          // Space would otherwise scroll the page out from under the widget.
          event.preventDefault();
          toggle(index);
          break;
        default:
          break;
      }
    }

    /* Upgrade the inert marks into controls. Done here rather than in the
       template so the static rendering never offers a control that does
       nothing. */
    svgRoot?.classList.add('is-interactive');
    svgRoot?.setAttribute('role', 'group');
    svgRoot?.setAttribute('aria-label', 'Attempts');

    /* The <svg> ships as role="img", which is right while it is a picture:
       assistive tech reads the alt text and ignores the children. Once the
       marks become controls that is exactly wrong, because it would bury ten
       buttons inside a single image node. Re-label it as a group and move the
       description onto the figure, so the alt text survives and the controls
       are reachable. */
    const svg = root.querySelector<SVGSVGElement>('.trace__svg');
    const description = svg?.getAttribute('aria-label') ?? '';
    if (svg) {
      svg.setAttribute('role', 'group');
      svg.removeAttribute('aria-label');
    }
    const summary = root.querySelector<HTMLElement>('[data-summary]');
    if (summary) summary.textContent = description;

    groups.forEach((group, i) => {
      const index = Number(group.dataset.index);
      group.setAttribute('role', 'button');
      group.setAttribute('tabindex', i === 0 ? '0' : '-1');
      group.addEventListener('click', () => {
        focusMark(i, false);
        toggle(index);
      });
      group.addEventListener('keydown', (event) => onKeydown(event, index));
      group.addEventListener('focus', () => focusMark(i, false));
    });

    const instructions = root.querySelector<HTMLElement>('[data-instructions]');
    if (instructions) instructions.hidden = false;

    paintMarks();
  }
</script>
