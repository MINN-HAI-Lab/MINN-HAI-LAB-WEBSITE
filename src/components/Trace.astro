---
/**
 * The knowledge trace.
 *
 * This file emits the *static* rendering: real SVG, built at build time, in
 * the HTML, with no client JavaScript. It is what a reader gets with
 * JavaScript off and what everyone sees before hydration, and CLAUDE.md
 * requires it to be "an actual readable rendering of the same data", not a
 * placeholder. The interactive layer is added later (T-10) on top of this
 * exact markup.
 *
 * The data is synthetic and the widget says so on its face.
 */
import { describe, formatPercent, trace } from '../lib/mastery.ts';
import { VIEW, layout, yFor } from '../lib/trace-geometry.ts';
import { tokenNumber } from '../lib/tokens.ts';
import { EXAMPLE_ATTEMPTS, EXAMPLE_SKILL } from '../data/trace-example.ts';
import tokens from '../styles/tokens.css?raw';

interface Props {
  /** Sequence to render. Defaults to the synthetic example. */
  attempts?: readonly boolean[];
  /** Skill the sequence is about. */
  skill?: string;
}

const { attempts = EXAMPLE_ATTEMPTS, skill = EXAMPLE_SKILL } = Astro.props;

const result = trace(attempts);
const geometry = layout(result);
const sentence = describe(result, skill);

/* Geometry read from the tokens rather than typed in, so a change to
   --mark-size moves the marks, the attribution ring and the key together
   instead of moving one and leaving the others behind. */

/** --mark-size is a diameter; SVG wants a radius. */
const markSize = tokenNumber(tokens, 'mark-size');
const markRadius = markSize / 2;

/** Stroke width for marks and the curve. */
const strokeWidth = tokenNumber(tokens, 'curve-width');

/** The attribution ring sits one spacing step outside the mark. */
const ringRadius = markRadius + tokenNumber(tokens, 'space-1');

/** Key swatches are drawn at --mark-size, inset by half a stroke so the
 *  outline of an open circle is not clipped by the viewBox. */
const swatchRadius = markRadius - strokeWidth / 2;

const correctCount = result.steps.filter((step) => step.correct).length;

/**
 * Where the top and bottom of the plotted area sit, as a percentage of the
 * SVG's height.
 *
 * The axis labels and the synthetic stamp are HTML, not SVG text, because SVG
 * text scales with the viewBox: at 390px the drawing renders at 0.42 of
 * nominal and 15px type became 6px, well under the floor DESIGN.md sets. HTML
 * text keeps its size at every width. These percentages are what re-attach it
 * to the right rows of the chart, and they are derived from the same geometry
 * constants rather than eyeballed.
 */
const topPercent = (VIEW.chartTop / VIEW.height) * 100;
const bottomPercent = (VIEW.chartBottom / VIEW.height) * 100;

/**
 * Text alternative. Describes what the drawing shows, not what it is — "a
 * line chart" would tell a screen reader user nothing they can act on.
 */
const altText =
  `Knowledge trace over ${result.steps.length} attempts at ${skill}, ` +
  `${correctCount} correct. The model's estimate starts at ` +
  `${formatPercent(result.initial)} per cent, before any attempt, and ` +
  `ends at ${formatPercent(result.final)} per cent. A shaded band around ` +
  `the line shows the model's uncertainty, which narrows as attempts ` +
  `accumulate.`;
---

<figure
  class="trace"
  data-trace
  data-attempts={JSON.stringify(attempts)}
  data-skill={skill}
  style={`--trace-plot-width: ${VIEW.width}px`}
>
  <div class="trace__panel">
    {/* Positioned wrapper. The axis labels and the synthetic stamp sit here as
        HTML rather than inside the SVG, so they keep their size when the
        drawing scales down. */}
    <div class="trace__plot">
      <span class="trace__axis-label" style={`top: ${topPercent}%`} aria-hidden="true">1</span>
      <span class="trace__axis-label" style={`top: ${bottomPercent}%`} aria-hidden="true">0</span>

      <svg
      class="trace__svg"
      viewBox={`0 0 ${VIEW.width} ${VIEW.height}`}
      role="img"
      aria-label={altText}
      preserveAspectRatio="xMidYMid meet"
    >
      <title>Knowledge trace for {skill}</title>

      {/* Baseline. A hairline, decorative, so --rule is the right weight. */}
      <line
        class="trace__axis"
        x1={VIEW.padX}
        y1={yFor(0)}
        x2={VIEW.width - VIEW.padX}
        y2={yFor(0)}
      />

      {/* Uncertainty band. The fill is a wash at 12% and cannot carry the
          information on its own (1.22:1 against the panel), so the 1px --claim
          edges do it. D-013. */}
      {geometry.bandPath && (
        <>
          <path class="trace__band" d={geometry.bandPath} data-band />
          <path class="trace__band-edge" d={geometry.bandUpperPath} data-band-upper />
          <path class="trace__band-edge" d={geometry.bandLowerPath} data-band-lower />
        </>
      )}

      {/* The estimate itself. The only --claim line on the page. */}
      <path class="trace__curve" d={geometry.curvePath} data-curve />

      {/* Attempts. Shape carries correct/incorrect, not colour, so the trace
          still reads in greyscale and for colour-blind readers. */}
      {/* Rendered inert. The script upgrades each group to a button once it
          runs, so with JavaScript off these stay honest marks rather than
          controls that look live and do nothing. */}
      <g class="trace__marks" data-marks>
        {geometry.marks.map((mark) => (
          <g class="trace__mark-group" data-index={mark.index}>
            {/* A transparent rectangle spanning the whole slot, so the hit
                area clears the 24px WCAG minimum on a phone without
                inflating the 20px mark itself. A circle scaled down to 12px
                at 360px; this stays at 24. */}
            <rect
              class="trace__mark-hit"
              x={mark.x - geometry.slotWidth / 2}
              y={mark.y - VIEW.hitHeight / 2}
              width={geometry.slotWidth}
              height={VIEW.hitHeight}
            />
            {/* Attribution ring. Drawn always, revealed only in the
                attribution view. --claim is correct here and only here among
                the marks: the highlight is the model asserting which attempts
                it is leaning on, which is a claim about a person. The ring
                itself is the second cue, so the state does not rest on colour
                alone. */}
            <circle class="trace__mark-ring" cx={mark.x} cy={mark.y} r={ringRadius} />
            <circle
              class:list={['trace__mark', mark.correct ? 'is-correct' : 'is-incorrect']}
              cx={mark.x}
              cy={mark.y}
              r={markRadius}
            />
          </g>
        ))}
      </g>
      </svg>

      {/* DESIGN.md: "Label the synthetic data visibly inside the widget."
          Inside the panel, over the drawing, so a screenshot of the widget
          carries it. The caption states it in full; this is aria-hidden so a
          screen reader is not told twice. */}
      <span class="trace__stamp" aria-hidden="true">Synthetic data</span>
    </div>

    {/* Key. "Shape carries the distinction" only holds if a reader can decode
        which shape is which, so the two marks are shown at the size they
        appear, drawn by the same CSS. Nothing here relies on colour: printed
        in greyscale, or seen by a colour-blind reader, it reads the same. */}
    <ul class="trace__key">
      <li class="trace__key-item">
        <svg
          class="trace__key-swatch"
          viewBox={`0 0 ${markSize} ${markSize}`}
          aria-hidden="true"
          focusable="false"
        >
          <circle
            class="trace__mark is-correct"
            cx={markRadius}
            cy={markRadius}
            r={swatchRadius}
          />
        </svg>
        <span>A filled circle is an attempt answered correctly.</span>
      </li>
      <li class="trace__key-item">
        <svg
          class="trace__key-swatch"
          viewBox={`0 0 ${markSize} ${markSize}`}
          aria-hidden="true"
          focusable="false"
        >
          <circle
            class="trace__mark is-incorrect"
            cx={markRadius}
            cy={markRadius}
            r={swatchRadius}
          />
        </svg>
        <span>An open circle is an attempt answered incorrectly.</span>
      </li>
    </ul>

    {/* Hidden until the script runs. With JavaScript off none of this is
        true, and telling a reader to press keys that do nothing is worse than
        saying nothing. */}
    <p class="trace__instructions" data-instructions hidden>
      Select an attempt to change its answer and watch the estimate move. Use
      the arrow keys to move between attempts, then Enter or Space to change
      one.
    </p>

    {/* Attribution view. A real <button>, so it is keyboard reachable and
        announces its pressed state without any help. Hidden until the script
        runs, for the same reason as the instructions. */}
    <div class="trace__controls" data-controls hidden>
      <button class="button" type="button" data-attribution aria-pressed="false">
        Show which attempts carry the estimate
      </button>
    </div>
  </div>

  <figcaption class="trace__caption">
    {/* Holds the graphic's description once the SVG stops being an image and
        becomes a group of controls. Empty and off-screen until then, because
        while role="img" is on the SVG the same text is already the alt. */}
    <p class="visually-hidden" data-summary></p>

    {/* Announces the estimate after a toggle.

        Polite, never assertive: this is the result of something the reader
        just did, not an error or an interruption, and assertive would cut off
        whatever the screen reader was already saying.

        Empty in the HTML and populated only by the script. A live region has
        to be in the DOM before its content changes or the change goes
        unannounced, and pre-filling it would make some screen readers read the
        initial state out on page load for no reason. */}
    <p class="visually-hidden" data-live role="status" aria-live="polite"></p>

    <p class="trace__sentence" data-sentence>{sentence}</p>
    <p class="trace__synthetic">
      Synthetic data. This sequence was invented to illustrate the method. It
      is not a recording of a learner and not output from a model trained on
      student data.
    </p>
  </figcaption>
</figure>

<script>
  /**
   * The interactive layer.
   *
   * Progressive enhancement over the static SVG: the markup is already correct
   * and readable before this runs, and everything below only upgrades it. With
   * JavaScript off the marks stay inert, which is why they are not rendered as
   * buttons server-side.
   *
   * Geometry comes from the same layout() the build used, so the interactive
   * trace and the static one cannot disagree about where anything goes.
   */
  import { attribute, describe, describeAttribution, trace } from '../lib/mastery.ts';
  import { blend, layout } from '../lib/trace-geometry.ts';
  import { EASE_OUT, cubicBezier, durationToMs } from '../lib/easing.ts';

  const root = document.querySelector<SVGElement & HTMLElement>('[data-trace]');

  if (root) {
    /* Captured non-null. TypeScript narrows `root` for straight-line code but
       not inside function declarations, which could in principle be called
       after it changed. */
    const el = root;

    const svgRoot = el.querySelector('[data-marks]');
    const band = el.querySelector<SVGPathElement>('[data-band]');
    const bandUpper = el.querySelector<SVGPathElement>('[data-band-upper]');
    const bandLower = el.querySelector<SVGPathElement>('[data-band-lower]');
    const curve = el.querySelector<SVGPathElement>('[data-curve]');
    const sentence = el.querySelector<HTMLElement>('[data-sentence]');
    const groups = [...el.querySelectorAll<SVGGElement>('[data-index]')];

    const skill = el.dataset.skill ?? '';
    let attempts: boolean[] = JSON.parse(el.dataset.attempts ?? '[]');
    let result = trace(attempts);

    /* Motion values are read from the tokens rather than repeated here, so
       DESIGN.md stays the single source. */
    const styles = getComputedStyle(document.documentElement);
    const duration = durationToMs(styles.getPropertyValue('--dur-base'));
    const drawDuration = durationToMs(styles.getPropertyValue('--dur-slow'));
    const ease = cubicBezier(EASE_OUT);

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    let frame = 0;

    /** Push one geometry onto the DOM. */
    function paint(at: ReturnType<typeof trace>): void {
      const geometry = layout(at);
      curve?.setAttribute('d', geometry.curvePath);
      band?.setAttribute('d', geometry.bandPath);
      bandUpper?.setAttribute('d', geometry.bandUpperPath);
      bandLower?.setAttribute('d', geometry.bandLowerPath);
    }

    let attributing = false;

    /** Redraw the marks to match the current attempts. */
    function paintMarks(): void {
      const attributions = attribute(attempts);

      for (const group of groups) {
        const index = Number(group.dataset.index);
        const correct = attempts[index] === true;
        const carrying = attributions[index]?.carrying === true;

        const mark = group.querySelector('.trace__mark');
        mark?.classList.toggle('is-correct', correct);
        mark?.classList.toggle('is-incorrect', !correct);
        group.classList.toggle('is-carrying', carrying);

        group.setAttribute('aria-pressed', String(correct));

        // The attribution state belongs in the name, not just the ring, or a
        // screen reader user gets no version of the view at all.
        const carries =
          attributing && carrying ? ' This attempt is carrying the estimate.' : '';
        group.setAttribute(
          'aria-label',
          `Attempt ${index + 1}, answered ${correct ? 'correctly' : 'incorrectly'}.` +
            `${carries} Activate to mark it ${correct ? 'incorrect' : 'correct'}.`,
        );
      }
    }

    /**
     * Animate from the current estimate to the next one.
     *
     * DESIGN.md: the movement is the information, so it decelerates into the
     * new value with --ease-out over --dur-base. Under reduced motion the
     * value is set outright rather than transitioned at zero duration, which
     * would produce a jump.
     */
    let highlightTimer = 0;

    /**
     * The reduced-motion substitute for the estimate animation.
     *
     * DESIGN.md is specific: "an instant update plus a brief static
     * highlight, so the change is still visible", and warns against setting
     * duration to zero on a transform, which produces a jump rather than
     * removing motion. So the value is set outright and the curve is marked
     * for a moment. The highlight has no transition on it and nothing moves:
     * it appears, holds, and goes.
     */
    function flashHighlight(): void {
      if (!curve) return;
      window.clearTimeout(highlightTimer);
      // How long the highlight holds. --dur-slow, falling back to --dur-base
      // rather than to a number typed in here: if neither token reads, there
      // is no motion budget to spend and the highlight is skipped.
      const hold = drawDuration || duration;
      if (hold <= 0) return;

      curve.classList.add('is-changed');
      highlightTimer = window.setTimeout(() => {
        curve.classList.remove('is-changed');
      }, hold);
    }

    function animateTo(next: ReturnType<typeof trace>): void {
      cancelAnimationFrame(frame);

      if (reduceMotion.matches || duration <= 0) {
        result = next;
        paint(result);
        flashHighlight();
        return;
      }

      const from = result;
      const started = performance.now();

      const step = (now: number): void => {
        const elapsed = now - started;
        const progress = Math.min(elapsed / duration, 1);
        paint(blend(from, next, ease(progress)));
        if (progress < 1) frame = requestAnimationFrame(step);
        else result = next;
      };

      frame = requestAnimationFrame(step);
    }

    const live = el.querySelector<HTMLElement>('[data-live]');
    let announceTimer = 0;

    /**
     * Announce the new estimate, once the dust settles.
     *
     * Held back by the animation duration so that arrowing across several
     * attempts and flipping them in quick succession produces one useful
     * sentence rather than a queue of half-stale ones. The announcement names
     * the attempt that changed, because "99 per cent" on its own does not tell
     * a listener what moved.
     */
    function announce(at: ReturnType<typeof trace>, index: number): void {
      if (!live) return;
      window.clearTimeout(announceTimer);
      const correct = attempts[index] === true;
      const settle = reduceMotion.matches ? 0 : duration;
      announceTimer = window.setTimeout(() => {
        live.textContent =
          `Attempt ${index + 1} is now ${correct ? 'correct' : 'incorrect'}. ` +
          describe(at, skill);
      }, settle);
    }

    /** Flip one attempt and redraw everything that depends on it. */
    function toggle(index: number): void {
      if (!Number.isInteger(index) || index < 0 || index >= attempts.length) return;
      attempts = attempts.map((value, i) => (i === index ? !value : value));
      const next = trace(attempts);
      paintMarks();
      if (sentence) sentence.textContent = describe(next, skill);
      announce(next, index);
      animateTo(next);
    }

    /**
     * Roving tabindex.
     *
     * Ten attempts should cost one Tab stop, not ten. Exactly one mark is in
     * the tab order at a time and the arrow keys move between them, which is
     * the expected behaviour for a composite control and keeps the trace from
     * swamping the page's tab sequence.
     */
    let active = 0;

    function focusMark(next: number, moveFocus = true): void {
      active = Math.max(0, Math.min(next, groups.length - 1));
      groups.forEach((group, i) => {
        group.setAttribute('tabindex', i === active ? '0' : '-1');
      });
      if (moveFocus) groups[active]?.focus();
    }

    function onKeydown(event: KeyboardEvent, index: number): void {
      switch (event.key) {
        case 'ArrowRight':
        case 'ArrowDown':
          event.preventDefault();
          focusMark(index + 1);
          break;
        case 'ArrowLeft':
        case 'ArrowUp':
          event.preventDefault();
          focusMark(index - 1);
          break;
        case 'Home':
          event.preventDefault();
          focusMark(0);
          break;
        case 'End':
          event.preventDefault();
          focusMark(groups.length - 1);
          break;
        case 'Enter':
        case ' ':
        case 'Spacebar':
          // Space would otherwise scroll the page out from under the widget.
          event.preventDefault();
          toggle(index);
          break;
        default:
          break;
      }
    }

    /**
     * Put the widget back the way it was served.
     *
     * If the upgrade throws partway through, the page is left with some marks
     * interactive and some not, a pointer cursor promising behaviour that is
     * gone, and possibly an SVG relabelled as a group of controls that no
     * longer exist. That is worse than never having run: the static rendering
     * is complete and honest on its own, so failing back to it loses nothing
     * but the interaction.
     */
    function revert(): void {
      svgRoot?.classList.remove('is-interactive', 'is-attributing');
      svgRoot?.removeAttribute('role');
      svgRoot?.removeAttribute('aria-label');

      const svgEl = el.querySelector<SVGSVGElement>('.trace__svg');
      const summaryEl = el.querySelector<HTMLElement>('[data-summary]');
      if (svgEl && summaryEl?.textContent) {
        svgEl.setAttribute('role', 'img');
        svgEl.setAttribute('aria-label', summaryEl.textContent);
        summaryEl.textContent = '';
      }

      for (const group of groups) {
        group.removeAttribute('role');
        group.removeAttribute('tabindex');
        group.removeAttribute('aria-pressed');
        group.removeAttribute('aria-label');
        group.classList.remove('is-carrying');
      }

      const instructionsEl = el.querySelector<HTMLElement>('[data-instructions]');
      const controlsEl = el.querySelector<HTMLElement>('[data-controls]');
      if (instructionsEl) instructionsEl.hidden = true;
      if (controlsEl) controlsEl.hidden = true;

      if (curve) {
        curve.style.strokeDasharray = '';
        curve.style.strokeDashoffset = '';
        curve.classList.remove('is-changed');
      }
    }

    /* Upgrade the inert marks into controls. Done here rather than in the
       template so the static rendering never offers a control that does
       nothing. */
    function upgrade(): void {
    svgRoot?.classList.add('is-interactive');
    svgRoot?.setAttribute('role', 'group');
    svgRoot?.setAttribute('aria-label', 'Attempts');

    /* The <svg> ships as role="img", which is right while it is a picture:
       assistive tech reads the alt text and ignores the children. Once the
       marks become controls that is exactly wrong, because it would bury ten
       buttons inside a single image node. Re-label it as a group and move the
       description onto the figure, so the alt text survives and the controls
       are reachable. */
    const svg = el.querySelector<SVGSVGElement>('.trace__svg');
    const description = svg?.getAttribute('aria-label') ?? '';
    if (svg) {
      svg.setAttribute('role', 'group');
      svg.removeAttribute('aria-label');
    }
    const summary = el.querySelector<HTMLElement>('[data-summary]');
    if (summary) summary.textContent = description;

    groups.forEach((group, i) => {
      const index = Number(group.dataset.index);
      group.setAttribute('role', 'button');
      group.setAttribute('tabindex', i === 0 ? '0' : '-1');
      group.addEventListener('click', () => {
        focusMark(i, false);
        toggle(index);
      });
      group.addEventListener('keydown', (event) => onKeydown(event, index));
      group.addEventListener('focus', () => focusMark(i, false));
    });

    const instructions = el.querySelector<HTMLElement>('[data-instructions]');
    if (instructions) instructions.hidden = false;

    /**
     * The attribution view.
     *
     * Answers "which past attempts is this estimate resting on" by flipping
     * each attempt in turn and measuring how far the conclusion moves. The
     * reader can check the answer by clicking the same attempt themselves,
     * which is the point: the explanation is falsifiable in the widget.
     */
    const controls = el.querySelector<HTMLElement>('[data-controls]');
    const attributionButton = el.querySelector<HTMLButtonElement>('[data-attribution]');
    if (controls) controls.hidden = false;

    function setAttribution(next: boolean): void {
      attributing = next;
      svgRoot?.classList.toggle('is-attributing', attributing);
      attributionButton?.setAttribute('aria-pressed', String(attributing));
      if (attributionButton) {
        attributionButton.textContent = attributing
          ? 'Hide which attempts carry the estimate'
          : 'Show which attempts carry the estimate';
      }
      paintMarks();
      if (live) {
        live.textContent = attributing
          ? describeAttribution(attribute(attempts))
          : 'Attribution view hidden.';
      }
    }

    attributionButton?.addEventListener('click', () => setAttribution(!attributing));

    paintMarks();

    /**
     * The one orchestrated moment on load: the mastery curve draws in, once,
     * over --dur-slow.
     *
     * Under reduced motion this does not run at all, so the reader gets the
     * finished curve — which is already what the HTML contains, since the
     * dash offset is only ever applied here. Nothing is hidden that could fail
     * to be revealed.
     */
    function drawCurveOnce(): void {
      if (!curve || reduceMotion.matches || drawDuration <= 0) return;

      let length = 0;
      try {
        length = curve.getTotalLength();
      } catch {
        // getTotalLength can throw on a detached or zero-length path. The
        // finished curve is already on screen, so there is nothing to repair.
        return;
      }
      if (!Number.isFinite(length) || length <= 0) return;

      curve.style.strokeDasharray = `${length}`;
      curve.style.strokeDashoffset = `${length}`;

      const started = performance.now();
      const step = (now: number): void => {
        const progress = Math.min((now - started) / drawDuration, 1);
        curve.style.strokeDashoffset = `${length * (1 - ease(progress))}`;
        if (progress < 1) {
          requestAnimationFrame(step);
        } else {
          // Leave no inline state behind, or a later toggle would redraw
          // against a stale dash pattern.
          curve.style.strokeDasharray = '';
          curve.style.strokeDashoffset = '';
        }
      };
      requestAnimationFrame(step);
    }

    drawCurveOnce();
    }

    try {
      upgrade();
    } catch (error) {
      // Leave a readable page rather than a broken one. The static rendering
      // is complete on its own, so this costs the interaction and nothing else.
      revert();
      console.error('The trace widget could not be made interactive.', error);
    }
  }
</script>
