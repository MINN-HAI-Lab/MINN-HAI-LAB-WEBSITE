---
/**
 * Site header, from the design canvas.
 *
 * The lab name in the serif on the left; Research, Learning, People and About
 * in the grotesk on the right, then one outlined button. The canvas labels
 * that button "Partner with us" and it goes to the contact section — which is
 * a gap until the address is supplied, but the way in should exist before the
 * address does.
 */
import { LAB_NAME, NAVIGATION } from '../data/navigation.ts';
import { withBase } from '../lib/paths.ts';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = NAVIGATION.filter((item) => item.href !== '/');
---

<header class="site-header">
  <div class="page site-header__inner">
    <a class="site-header__name" href={withBase('/')}>{LAB_NAME}</a>

    <nav aria-label="Main">
      <ul class="site-header__nav">
        {
          links.map((item) => (
            <li>
              <a
                class="site-header__link"
                href={withBase(item.href)}
                aria-current={current === item.href.replace(/\/$/, '') ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="button site-header__cta" href={withBase('/about#contact')}>Partner with us</a>
        </li>
      </ul>
    </nav>
  </div>
</header>
