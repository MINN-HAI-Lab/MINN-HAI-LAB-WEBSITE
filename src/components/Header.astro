---
/**
 * Site header.
 *
 * Set type, not a wordmark: there is no wordmark yet. Sans for the navigation
 * because it is instrument furniture; serif for the lab name because it is
 * the one piece of prose up here.
 */
import { LAB_NAME, NAVIGATION } from '../data/navigation.ts';
import { withBase } from '../lib/paths.ts';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="page site-header__inner">
    <a class="site-header__name" href={withBase('/')}>{LAB_NAME}</a>

    <nav aria-label="Main">
      <ul class="site-header__nav">
        {
          NAVIGATION.map((item) => (
            <li>
              <a
                class="site-header__link"
                href={withBase(item.href)}
                aria-current={current === item.href.replace(/\/$/, '') || (item.href === '/' && current === '/') ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
