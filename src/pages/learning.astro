---
/**
 * Learning — the Learning panel. See src/layouts/Layout.astro for the
 * chrome and the transcription notes that apply to every page.
 *
 * padding-top:96px on the wrapper clears the fixed header — the same 96px
 * used site-wide for [id]{scroll-margin-top}. The canvas's own sections
 * that open a page (the hero, Research's band) are dark and full-bleed, so
 * the header floats over them by design; this one is a plain gutter section
 * starting near the top of the page, so it needs the header's height
 * reserved above it instead.
 */
import Layout from '../layouts/Layout.astro';
---

<Layout title="Learning — MINN HAI Lab">
<div style="background:var(--field);padding-top:96px">
  <div class="mh-gutter" id="learning" style="padding:44px;border-bottom:1px solid rgba(var(--ink-rgb),.1);display:flex;flex-direction:column;gap:20px">
    <div style="display:flex;align-items:baseline;justify-content:space-between;gap:16px"><h3 style="margin:0;font-family:Literata,serif;font-weight:400;font-size:30px;letter-spacing:-.015em">Learning</h3><span style="font-size:12.5px;color:rgba(var(--ink-rgb),.5)">Resources from the lab</span></div>
    <div style="display:flex;flex-wrap:wrap;gap:8px" role="tablist">
      <button class="mh-tab" type="button" role="tab" aria-selected="true" data-mh-tab="0">StatLab</button>
      <button class="mh-tab" type="button" role="tab" aria-selected="false" data-mh-tab="1">Course materials</button>
    </div>
    <div style="min-height:140px">
      <div data-mh-panel="0">
        <div style="display:flex;flex-direction:column;gap:12px;max-width:70ch">
          <div style="font-family:Literata,serif;font-size:19px;line-height:1.3">StatLab</div>
          <p style="margin:0;font-size:14.5px;line-height:1.6;color:rgba(var(--ink-rgb),.68)">An interactive introduction to probability and statistics. Runs in the browser.</p>
          <a href="https://minn-hai-lab.github.io/statLab/index.html" target="_blank" rel="noopener" style="align-self:flex-start;font-size:13px;color:var(--field);background:var(--ink);text-decoration:none;border-radius:2px;padding:12px 20px;font-weight:500">Open StatLab</a>
        </div>
      </div>
      <div data-mh-panel="1" hidden>
        <div style="display:flex;flex-direction:column;gap:12px;max-width:70ch">
          <div style="font-family:Literata,serif;font-size:19px;line-height:1.3">Course materials</div>
          <p style="margin:0;font-size:14.5px;line-height:1.6;color:rgba(var(--ink-rgb),.68)">The source code and visualizations used in StatLab.</p>
          <a href="https://github.com/MINN-HAI-Lab/statLab_Codes" target="_blank" rel="noopener" style="align-self:flex-start;font-size:13px;color:var(--field);background:var(--ink);text-decoration:none;border-radius:2px;padding:12px 20px;font-weight:500">View source</a>
        </div>
      </div>
    </div>
  </div>
</div>
</Layout>
