---
/**
 * Members — grouped Founder / Post Doctoral / Doctoral / Master, one
 * profile row per person (D-055). See src/layouts/Layout.astro for the
 * chrome and the transcription notes that apply to every page.
 *
 * padding-top:96px on the wrapper clears the fixed header; see the same
 * note in learning.astro.
 *
 * ── How to add or fill in a member ─────────────────────────────────────
 * Everything on this page comes from the `groups` array below. Each
 * person is one object; the template renders whatever is filled in and
 * marks whatever isn't with a TODO. To add someone or complete an entry,
 * edit the data only — the markup below needs no change.
 *
 *   {
 *     name:  'Full Name',            // null while unknown → "TODO: name"
 *     role:  'PhD student',          // shown under the name
 *     photo: 'Full_Name.jpg',        // null while unknown → striped placeholder
 *     bio:   ['Paragraph one.', 'Paragraph two.'],   // null while unknown
 *     links: [                                       // [] while unknown
 *       { label: 'Google Scholar', href: 'https://scholar.google.com/…' },
 *       { label: 'LinkedIn',       href: 'https://www.linkedin.com/in/…' },
 *     ],
 *   }
 *
 * Photo: drop the original in pics/ (gitignored), then resize it into
 * public/members/ under the same name the `photo` field uses —
 *   sips -Z 900 -s formatOptions 82 pics/Full_Name.jpg --out public/members/Full_Name.jpg
 * — the same treatment every existing portrait had (D-040, D-049).
 *
 * Bio and links must be supplied by the member (or by Kaung on their
 * behalf), verbatim. Do not write a bio for a real person from nothing,
 * and do not guess a URL — a wrong link or an invented claim on a
 * researcher's public profile is worse than a visible TODO. Bio copy
 * follows the site's rules: sentence case, no exclamation marks, no
 * emoji. Link labels are the service's own name ("Google Scholar",
 * "LinkedIn", "Facebook", "GitHub", "ORCID", "Website"…); any number, in
 * any order.
 * ───────────────────────────────────────────────────────────────────────
 *
 * Portraits are public/members/<Name>.jpg, resized from the originals in
 * pics/ down to 900px on the long side for the web.
 */
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

type Link = { label: string; href: string };
type Person = { name: string | null; role: string; photo: string | null; bio: string[] | null; links: Link[] };
type Group = { label: string; people: Person[] };

const groups: Group[] = [
  {
    label: 'Faculty',
    people: [
      { name: 'Dr. Sein Minn', role: 'Founder', photo: 'Sein_Minn.jpg', bio: null, links: [] },
    ],
  },
  {
    label: 'Post Doctoral',
    people: [
      { name: null, role: 'Postdoctoral researcher', photo: null, bio: null, links: [] },
      { name: null, role: 'Postdoctoral researcher', photo: null, bio: null, links: [] },
    ],
  },
  {
    label: 'Doctoral',
    people: [
      {
        name: 'Md Kamal Hosen',
        role: 'PhD student',
        photo: 'Md_Kamal_Hosen.jpg',
        bio: [
          'Kamal is a PhD researcher in Data Science and Artificial Intelligence at the Asian Institute of Technology (AIT). His doctoral research aims to develop physics-informed neural operators for modeling urban heat at the canopy layer, combining physical constraints with deep learning to produce fast, accurate, and physically consistent models of city climate. More broadly, his research interests include GeoAI for climate and disaster resilience, integrating Earth observation, spatial data, computer vision, and reliable agentic AI systems to support risk assessment and decision-making.',
          'He is also a Geospatial Web Developer at the Asian Disaster Preparedness Center (ADPC) in Bangkok. He develops operational geospatial systems across a wide range of sectors, including flood monitoring, flash flood guidance, weather advisory systems, impact-based forecasting and early warning, land cover and ecosystem monitoring, mining monitoring, air quality monitoring, drought monitoring, and water quality and pollution monitoring. He also builds automated bulletin systems that turn these data streams into decision support for government agencies. His research-driven work includes GeoAI pipelines for flood detection and impact assessment and landslide prediction using open-source data and machine learning. With a background in urban planning, GIS and remote sensing, and software engineering, he has worked across eight countries in Asia: Bangladesh, Thailand, Sri Lanka, Bhutan, Cambodia, Lao PDR, Vietnam, and Myanmar.',
        ],
        links: [],
      },
      { name: null, role: 'PhD student', photo: null, bio: null, links: [] },
      { name: null, role: 'PhD student', photo: null, bio: null, links: [] },
    ],
  },
  {
    label: 'Master',
    people: [
      { name: 'Aung Khant Maung', role: "Master's student", photo: 'Aung_Khant_Maung.jpg', bio: null, links: [] },
      { name: 'Thet Htun Swe', role: "Master's student", photo: 'Thet_Htun_Swe.jpg', bio: null, links: [] },
      { name: 'Kaung Hein Htet', role: "Master's student", photo: 'Kaung_Hein_Htet.jpg', bio: null, links: [] },
      { name: 'Win Htut Naing', role: "Master's student", photo: 'Win_Htut_Naing.jpg', bio: null, links: [] },
    ],
  },
];

// What a row is still waiting on, for its TODO marker.
const missing = (p: Person) =>
  [!p.name && 'name and photo', !p.bio && 'bio', p.links.length === 0 && 'links (Google Scholar, LinkedIn, …)'].filter(
    (x): x is string => Boolean(x),
  );
---

<Layout title="Members — MINN HAI Lab">
<div style="background:var(--field);padding-top:96px">
  <div class="mh-gutter" id="members" style="padding:44px;border-bottom:1px solid rgba(var(--ink-rgb),.1);display:flex;flex-direction:column;gap:44px">
    <div style="display:flex;align-items:baseline;justify-content:space-between"><h3 style="margin:0;font-family:Literata,serif;font-weight:400;font-size:30px;letter-spacing:-.015em">Members</h3></div>
    {groups.map((g) => (
      <div style="display:flex;flex-direction:column;gap:12px">
        <div style="font-family:Literata,serif;font-size:19px;line-height:1.3">{g.label}</div>
        <div style="display:flex;flex-direction:column">
          {g.people.map((p) => (
            <div class="mh-profile" style="display:grid;grid-template-columns:180px minmax(0,1fr);gap:32px;align-items:start;padding:28px 0;border-top:1px solid rgba(var(--ink-rgb),.08)">
              {p.photo ? (
                <div style="aspect-ratio:4/5;border:1px solid rgba(var(--ink-rgb),.14);border-radius:3px;overflow:hidden">
                  <img src={`${base}/members/${p.photo}`} alt={p.name ?? ''} loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block" />
                </div>
              ) : (
                <div style="aspect-ratio:4/5;border:1px solid rgba(var(--ink-rgb),.14);border-radius:3px;background:repeating-linear-gradient(135deg,rgba(var(--ink-rgb),.05) 0 6px,transparent 6px 12px);display:flex;align-items:flex-end;padding:12px">
                  <span style="font-family:ui-monospace,Menlo,monospace;font-size:10.5px;color:rgba(var(--ink-rgb),.5)">portrait</span>
                </div>
              )}
              <div style="display:flex;flex-direction:column;gap:14px;max-width:70ch">
                <div>
                  <div style="font-family:Literata,serif;font-size:16px">{p.name ?? 'TODO: name'}</div>
                  <div style="font-size:12px;color:rgba(var(--ink-rgb),.5);margin-top:3px">{p.role}</div>
                </div>
                {p.bio && p.bio.map((t) => (
                  <p style="margin:0;font-size:14.5px;line-height:1.6;color:rgba(var(--ink-rgb),.7)">{t}</p>
                ))}
                {p.links.length > 0 && (
                  <div style="display:flex;flex-wrap:wrap;gap:8px">
                    {p.links.map((l) => (
                      <a href={l.href} target="_blank" rel="noopener" style="border:1px solid rgba(var(--ink-rgb),.18);border-radius:2px;padding:5px 10px;font-size:12px;color:rgba(var(--ink-rgb),.72);text-decoration:none">{l.label}</a>
                    ))}
                  </div>
                )}
                {missing(p).length > 0 && (
                  <div style="border-left:3px solid rgba(var(--ink-rgb),.4);background:rgba(var(--field-rgb),.75);border-radius:3px;padding:12px 14px;font-size:13px;line-height:1.6;color:rgba(var(--ink-rgb),.82)">TODO: {missing(p).join(', ')} — to be supplied by the member.</div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>
</Layout>
