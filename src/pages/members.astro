---
/**
 * Members — the Members grid. See src/layouts/Layout.astro for the chrome
 * and the transcription notes that apply to every page.
 *
 * padding-top:96px on the wrapper clears the fixed header; see the same
 * note in learning.astro.
 *
 * Portraits are public/members/<Name>.jpg, supplied by Kaung and resized
 * from the originals (3000×3000) down to 900×900 for the web.
 */
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const people = [
  { name: 'Dr. Sein Minn', role: 'Founder', photo: 'Sein_Minn.jpg' },
  { name: 'Aung Khant Maung', role: 'Research Assistant', photo: 'Aung_Khant_Maung.jpg' },
  { name: 'Thet Htun Swe', role: 'Research Assistant', photo: 'Thet_Htun_Swe.jpg' },
  { name: 'Kaung Hein Htet', role: 'Research Assistant', photo: 'Kaung_Hein_Htet.jpg' },
  { name: 'Win Htut Naing', role: 'Research Assistant', photo: 'Win_Htut_Naing.jpg' },
];
---

<Layout title="Members — MINN HAI Lab">
<div style="background:#06080A;padding-top:96px">
  <div class="mh-gutter" id="members" style="padding:44px;border-bottom:1px solid rgba(230,237,240,.1);display:flex;flex-direction:column;gap:24px">
    <div style="display:flex;align-items:baseline;justify-content:space-between"><h3 style="margin:0;font-family:Literata,serif;font-weight:400;font-size:30px;letter-spacing:-.015em">Members</h3></div>
    <div class="mh-people" style="display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:20px">
      {people.map((p) => (
        <div style="display:flex;flex-direction:column;gap:12px">
          <div style="aspect-ratio:4/5;border:1px solid rgba(230,237,240,.14);border-radius:3px;overflow:hidden">
            <img src={`${base}/members/${p.photo}`} alt={p.name} loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block" />
          </div>
          <div><div style="font-family:Literata,serif;font-size:16px">{p.name}</div><div style="font-size:12px;color:rgba(230,237,240,.5);margin-top:3px">{p.role}</div></div>
        </div>
      ))}
    </div>
  </div>
</div>
</Layout>
