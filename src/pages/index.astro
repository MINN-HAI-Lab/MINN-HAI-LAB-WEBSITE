    <script is:inline>
      // From the canvas's own script: forward the pointer into the 3D scene's
      // frame so the overlays do not block the reach, and switch the learning
      // panel's tabs.
      (function () {
        window.addEventListener('pointermove', function (e) {
          document.querySelectorAll('iframe[data-mh-scene]').forEach(function (fr) {
            var r = fr.getBoundingClientRect();
            if (!r.width || !fr.contentWindow) return;
            var x = ((e.clientX - r.left) / r.width) * 2 - 1, y = ((e.clientY - r.top) / r.height) * 2 - 1;
            var out = x < -1.1 || x > 1.1 || y < -1.1 || y > 1.1;
            fr.contentWindow.postMessage(out ? { type: 'mh-pointer', out: true } : { type: 'mh-pointer', x: x, y: y }, '*');
          });
        }, { passive: true });

        var tabs = document.querySelectorAll('[data-mh-tab]');
        var panels = document.querySelectorAll('[data-mh-panel]');
        tabs.forEach(function (tab) {
          tab.addEventListener('click', function () {
            var i = tab.getAttribute('data-mh-tab');
            tabs.forEach(function (t) { t.setAttribute('aria-selected', t.getAttribute('data-mh-tab') === i ? 'true' : 'false'); });
            panels.forEach(function (p) { p.hidden = p.getAttribute('data-mh-panel') !== i; });
          });
        });
      })();
    </script>
