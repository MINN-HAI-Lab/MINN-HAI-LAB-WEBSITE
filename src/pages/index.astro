---
/**
 * MINN HAI Lab — the site, copied from the design canvas.
 *
 * Source: "MINN HAI LAB UI Design/MINN HAI LAB.dc.html". Direction 2a is the
 * hero; direction 1d is the rest of the site, in order. The markup below is
 * the canvas's own, with its inline styles, values and copy. What changed in
 * the transcription and nothing else:
 *
 *   - the design viewer's `x-import` wrapper is the `<mh-bg>` element it
 *     wrapped, and its `sc-if` / {{ }} template bits are the tab state they
 *     stood for, wired up in the script at the foot of the page;
 *   - the canvas's internal links (#1a, #1d) are this page's anchors;
 *   - there is one header: 2a's, fixed to the top of the page. The headers
 *     drawn inside 1a, 1b, 1c and 1d are not repeated;
 *   - the three hero directions from the canvas's first turn (1a, 1b, 1c)
 *     sit between the reach and the research index, in order, with their
 *     copy as drawn, to be changed later; their h1s are h2s so the page has
 *     one h1;
 *   - the page fills the screen rather than the 1340px artboard: every
 *     container with the artboard's 44/48px gutter carries .mh-gutter, the
 *     grids and the hero copy carry classes, and one stylesheet scales them
 *     through Bootstrap's breakpoints (576, 768, 992, 1200, 1400). Below
 *     768px the header's links become a Menu button.
 *
 * The 3D scene is public/design/hands-scene.html, and the fields are
 * public/design/mh-bg.js — both copied from the design folder untouched.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MINN HAI Lab</title>
    <meta name="description" content="MINN HAI Lab — human-centered AI. Adaptive, interpretable, socially responsible systems." />
    <meta name="theme-color" content="#06080A" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,300;0,7..72,400;0,7..72,500;1,7..72,400&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
    <style is:inline>
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:#15181b;font-family:"Space Grotesk",system-ui,sans-serif;color:#E6EDF0}
a{color:#E6EDF0}a:hover{color:#fff}
.mh-tab{font:500 12.5px "Space Grotesk",sans-serif;border-radius:999px;padding:9px 15px;cursor:pointer;border:1px solid rgba(230,237,240,.18);background:transparent;color:rgba(230,237,240,.68);transition:background .12s ease,color .12s ease,border-color .12s ease}
.mh-tab:hover{color:#E6EDF0;border-color:rgba(230,237,240,.42)}
.mh-tab[aria-selected="true"]{background:#E6EDF0;color:#06080A;border-color:#E6EDF0}
@keyframes mh-spark{0%,100%{transform:translate(-50%,-50%) scale(1);opacity:.5}50%{transform:translate(-50%,-50%) scale(1.4);opacity:1}}
@keyframes mh-blink{0%,100%{opacity:.25}50%{opacity:1}}
@keyframes mh-drift{0%{transform:translateY(0)}100%{transform:translateY(-8px)}}

/* -- Full-scale layout ---------------------------------------------------
   The canvas is drawn on a 1340px artboard. The page fills whatever screen it
   is on instead, and scales the artboard's gutters, grids and display sizes
   through the same breakpoints Bootstrap uses: 576, 768, 992, 1200, 1400.
   Inline styles are the canvas's own, so the overrides carry !important. */
html{scroll-behavior:smooth}
[id]{scroll-margin-top:96px}
.mh-page{width:100%}
/* The reach keeps a fixed frame because its copy is positioned inside it.
   The other frames grow with their content, so a stacked phone layout is
   never taller than the frame that holds it. */
.mh-frame{height:auto!important;min-height:100vh;min-height:100svh}
#top.mh-frame{height:100vh!important;height:100svh!important;min-height:640px;max-height:1100px}
.mh-menu{display:none}
/* The hidden attribute has to beat the nav's inline display:flex. */
.mh-mobile-nav[hidden]{display:none!important}

/* ≥1400: the artboard's own gutters, and the display sizes as drawn. */

/* <1400 */
@media (max-width:1399.98px){
  .mh-gutter{padding-left:40px!important;padding-right:40px!important}
}
/* <1200 */
@media (max-width:1199.98px){
  .mh-gutter{padding-left:32px!important;padding-right:32px!important}
  .mh-row{grid-template-columns:160px minmax(0,1fr) 260px!important;gap:28px!important}
  .mh-row.mh-row--full{grid-template-columns:160px minmax(0,1fr)!important}
}
/* <992 */
@media (max-width:991.98px){
  .mh-hero-grid{grid-template-columns:minmax(0,1fr)!important;align-items:start!important}
  .mh-gutter{padding-left:28px!important;padding-right:28px!important}
  .mh-row{grid-template-columns:minmax(0,1fr)!important;gap:20px!important}
  .mh-three{grid-template-columns:minmax(0,1fr)!important}
  .mh-three>div{border-right:0!important;border-bottom:1px solid rgba(230,237,240,.1)}
  .mh-people{grid-template-columns:repeat(3,minmax(0,1fr))!important}
  .mh-hero-copy{max-width:520px!important}
}
/* <768 */
@media (max-width:767.98px){
  .mh-gutter{padding-left:24px!important;padding-right:24px!important}
  .mh-hero-nav{display:none!important}
  .mh-menu{display:inline-block}
  .mh-wrap{flex-wrap:wrap!important}
  .mh-people{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  .mh-hero-copy{left:24px!important;right:24px!important;bottom:200px!important;max-width:none!important}
  .mh-hero-title{font-size:44px!important}
  .mh-display-104{font-size:56px!important}
  .mh-display-80{font-size:48px!important}
  .mh-display-68{font-size:44px!important}
  h2[style*="font-size:52px"]{font-size:40px!important}
  h3[style*="font-size:44px"]{font-size:34px!important}
  h3[style*="font-size:34px"]{font-size:28px!important}
  h3[style*="font-size:30px"]{font-size:26px!important}
}
/* <576 */
@media (max-width:575.98px){
  .mh-gutter{padding-left:20px!important;padding-right:20px!important}
  .mh-name{white-space:nowrap}
  .mh-hero-copy{left:20px!important;right:20px!important;bottom:190px!important}
  .mh-hero-title{font-size:38px!important}
  .mh-display-104{font-size:42px!important}
  .mh-display-80{font-size:40px!important}
  .mh-display-68{font-size:38px!important}
  .mh-people{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:14px!important}
  h2[style*="font-size:52px"]{font-size:34px!important}
  h3[style*="font-size:44px"]{font-size:30px!important}
  [style*="grid-template-columns:140px"]{grid-template-columns:minmax(0,1fr)!important;gap:6px!important}
}
    </style>
    <script is:inline src={`${base}/design/mh-bg.js`}></script>
  </head>
  <body>
    <div class="mh-page">
<!-- The one header. 2a's, fixed to the top of the page with 1d's ground
     behind it; the headers drawn inside 1a, 1b and 1c are not repeated. -->
<header class="mh-header" style="position:fixed;z-index:50;left:0;right:0;top:0;background:rgba(6,8,10,.8);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid rgba(230,237,240,.1)">
<div class="mh-gutter" style="display:flex;align-items:center;justify-content:space-between;padding:26px 48px">
  <span class="mh-name" style="font-family:Literata,serif;font-size:20px;letter-spacing:-.01em">MINN HAI Lab</span>
  <button class="mh-menu" type="button" aria-expanded="false" aria-controls="mh-mobile-nav" style="pointer-events:auto;font:500 12.5px 'Space Grotesk',sans-serif;color:#E6EDF0;background:transparent;border:1px solid rgba(230,237,240,.28);border-radius:2px;padding:9px 16px;cursor:pointer">Menu</button>
  <div class="mh-hero-nav" style="display:flex;gap:32px;align-items:center;pointer-events:auto">
    <a href="#research" style="font-size:13px;color:rgba(230,237,240,.62);text-decoration:none">Research</a>
    <a href="#learning" style="font-size:13px;color:rgba(230,237,240,.62);text-decoration:none">Learning</a>
    <a href="#people" style="font-size:13px;color:rgba(230,237,240,.62);text-decoration:none">Members</a>
    <a href="#join" style="font-size:12.5px;color:#E6EDF0;text-decoration:none;border:1px solid rgba(230,237,240,.28);border-radius:2px;padding:9px 16px">Partner with us</a>
  </div>
</div>
<nav id="mh-mobile-nav" class="mh-mobile-nav" hidden aria-label="Menu" style="position:absolute;z-index:6;left:0;right:0;top:100%;display:flex;flex-direction:column;background:rgba(6,8,10,.96);border-top:1px solid rgba(230,237,240,.1);border-bottom:1px solid rgba(230,237,240,.1)">
  <a href="#research" style="font-size:15px;color:#E6EDF0;text-decoration:none;padding:16px 24px;border-bottom:1px solid rgba(230,237,240,.08)">Research</a>
  <a href="#learning" style="font-size:15px;color:#E6EDF0;text-decoration:none;padding:16px 24px;border-bottom:1px solid rgba(230,237,240,.08)">Learning</a>
  <a href="#people" style="font-size:15px;color:#E6EDF0;text-decoration:none;padding:16px 24px;border-bottom:1px solid rgba(230,237,240,.08)">Members</a>
  <a href="#join" style="font-size:15px;color:#E6EDF0;text-decoration:none;padding:16px 24px">Partner with us</a>
</nav>
</header>
<div class="mh-hero" style="position:relative">
<div id="top" class="mh-frame" style="position:relative;height:920px;background:#06080A;overflow:hidden">
<div style="position:absolute;inset:0;z-index:0;background:radial-gradient(90% 70% at 50% 48%,#10151a 0%,#090c0f 55%,#06080A 100%)"></div>
<iframe data-mh-scene src={`${base}/design/hands-scene.html`} title="Human and robot hands reaching toward each other" style="position:absolute;inset:0;z-index:1;width:100%;height:100%;border:0;background:transparent"></iframe>





<div class="mh-hero-copy" style="position:absolute;z-index:4;left:48px;bottom:118px;max-width:440px;display:flex;flex-direction:column;gap:20px;pointer-events:none">
  <div style="display:flex;align-items:center;gap:12px"><span style="width:7px;height:7px;border-radius:50%;background:#D61A4A;animation:mh-blink 2.6s ease-in-out infinite"></span><span style="font-size:12px;color:rgba(230,237,240,.6)">Human-centered AI</span></div>
  <h1 class="mh-hero-title" style="margin:0;font-family:Literata,serif;font-weight:300;font-size:54px;line-height:1.02;letter-spacing:-.025em;color:#F2F6F8;text-wrap:pretty">The gap is the whole discipline.</h1>
  <p style="margin:0;font-size:17px;line-height:1.62;color:rgba(230,237,240,.72);max-width:42ch">We build AI that reaches back on human terms — adaptive, interpretable, accountable for how it arrived at what it says.</p>
</div>

</div>

<div style="position:absolute;z-index:5;left:0;right:0;bottom:0;border-top:1px solid rgba(230,237,240,.12);background:rgba(6,8,10,.62);backdrop-filter:blur(10px);pointer-events:none">
  <div class="mh-gutter mh-wrap" style="display:flex;align-items:center;justify-content:flex-end;gap:32px;padding:20px 48px">
        <div class="mh-wrap" style="display:flex;gap:26px;align-items:center;pointer-events:auto">
                  <a href="#research" style="font-size:12.5px;color:#E6EDF0;text-decoration:none;border-bottom:1px solid rgba(230,237,240,.4);padding-bottom:2px">Enter the lab</a>
    </div>
  </div>
</div>
</div>
<div style="display:flex;flex-direction:column;background:#06080A">

  <!-- The canvas's three earlier hero directions — 1a Deep Field, 1b Lattice,
     1c Signal Plane — in order, between the reach and the research index,
     as Kaung asked. Their copy is the canvas's and is to be changed later. -->
<div id="deep-field" class="mh-frame" style="position:relative;height:860px;background:#06080A">
<div style="position:absolute;left:54%;right:0;top:40px;bottom:260px;z-index:0">
<mh-bg mode="bayes" speed="1" style="position:absolute;inset:0"></mh-bg>
</div>
<div style="position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,rgba(6,8,10,.96) 0%,rgba(6,8,10,.7) 38%,rgba(6,8,10,0) 60%)"></div>
<div style="position:relative;z-index:2;height:100%;display:flex;flex-direction:column">
  
  <div class="mh-gutter mh-hero-grid" style="flex:1;display:grid;grid-template-columns:minmax(0,1fr);align-items:end;gap:48px;padding:48px">
    <div style="display:flex;flex-direction:column;gap:28px;max-width:820px">
      <div style="display:flex;align-items:center;gap:12px">
        <span style="width:7px;height:7px;border-radius:50%;background:#D61A4A;animation:mh-blink 2.6s ease-in-out infinite"></span>
        <span style="font-size:12px;color:rgba(230,237,240,.55)">Human-centered AI · two research programmes</span>
      </div>
      <h2 class="mh-display-80" style="margin:0;font-family:Literata,serif;font-weight:300;font-size:80px;line-height:.98;letter-spacing:-.03em;color:#F2F6F8;text-wrap:pretty;max-width:11ch">Intelligence you can observe.</h2>
      <p style="margin:0;max-width:56ch;font-size:17.5px;line-height:1.6;color:rgba(230,237,240,.72)">We build AI that models how people learn, decide and trust — adaptive systems that show their reasoning instead of asserting it.</p>
      <div class="mh-wrap" style="display:flex;gap:14px;align-items:center">
        <a href="#research" style="font-size:13.5px;color:#06080A;background:#E6EDF0;text-decoration:none;border-radius:2px;padding:14px 24px;font-weight:500">See the research</a>
        <a href="#learning" style="font-size:13.5px;color:#E6EDF0;text-decoration:none;border:1px solid rgba(230,237,240,.28);border-radius:2px;padding:14px 24px">Learning resources</a>
      </div>
    </div>
  </div>
  <div class="mh-three" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-top:1px solid rgba(230,237,240,.1)">
    <div class="mh-gutter" style="padding:22px 48px;border-right:1px solid rgba(230,237,240,.1)"><div style="font-family:Literata,serif;font-size:15px;color:#E6EDF0">Knowledge tracing</div><div style="font-size:12.5px;color:rgba(230,237,240,.55);margin-top:6px">Per-learner mastery, estimated attempt by attempt</div></div>
    <div class="mh-gutter" style="padding:22px 48px"><div style="font-family:Literata,serif;font-size:15px;color:#E6EDF0">Interpretable tabular models</div><div style="font-size:12.5px;color:rgba(230,237,240,.55);margin-top:6px">Bayesian networks and Markov blankets</div></div>
  </div>
</div>
</div>

<div id="lattice" class="mh-frame" style="position:relative;height:860px;background:#07090C">
<mh-bg mode="lattice" speed="1" style="position:absolute;inset:0;z-index:0"></mh-bg>
<div style="position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,rgba(7,9,12,.94) 0%,rgba(7,9,12,.6) 46%,rgba(7,9,12,.2) 100%)"></div>
<div style="position:relative;z-index:2;height:100%;display:flex;flex-direction:column">
  
  <div style="flex:1;display:flex;align-items:center;padding:0 44px">
    <div style="display:flex;flex-direction:column;gap:26px;max-width:660px">
      <h2 class="mh-display-68" style="margin:0;font-family:Literata,serif;font-weight:300;font-size:68px;line-height:1.04;letter-spacing:-.025em;color:#F2F6F8">Between human understanding and machine inference.</h2>
      <p style="margin:0;font-size:17px;line-height:1.62;color:rgba(230,237,240,.7);max-width:52ch">The MINN HAI Lab explores the synergy between the two — developing intelligent systems that are adaptive, interpretable and socially responsible, and that align with human values, cognitive processes and real-world needs.</p>
      <div style="display:flex;flex-direction:column;gap:0;border-top:1px solid rgba(230,237,240,.14)">
        <a href="#research" style="display:flex;align-items:baseline;justify-content:space-between;gap:24px;padding:18px 4px;border-bottom:1px solid rgba(230,237,240,.14);text-decoration:none;color:#E6EDF0"><span style="font-family:Literata,serif;font-size:19px">AI for personalised learning</span><span style="font-size:12.5px;color:rgba(230,237,240,.5)">Knowledge tracing</span></a>
        <a href="#research" style="display:flex;align-items:baseline;justify-content:space-between;gap:24px;padding:18px 4px;border-bottom:1px solid rgba(230,237,240,.14);text-decoration:none;color:#E6EDF0"><span style="font-family:Literata,serif;font-size:19px">Explaining tabular models</span><span style="font-size:12.5px;color:rgba(230,237,240,.5)">Bayesian networks</span></a>
      </div>
    </div>
  </div>
  <div class="mh-gutter" style="display:flex;align-items:center;justify-content:space-between;padding:22px 44px;border-top:1px solid rgba(230,237,240,.1)">
    <span style="font-size:12px;color:rgba(230,237,240,.45)">Move the cursor — the lattice is the lab's Markov-blanket graph, not decoration</span>
    <div style="display:flex;align-items:center;gap:10px"><span style="width:6px;height:6px;border-radius:50%;background:#D61A4A"></span><span style="font-size:12px;color:rgba(230,237,240,.6)">node in the blanket of the target variable</span></div>
  </div>
</div>
</div>

<div id="signal-plane" class="mh-frame" style="position:relative;height:860px;background:#080A0D">
<mh-bg mode="grid" speed="1" style="position:absolute;inset:0;z-index:0"></mh-bg>
<div style="position:absolute;inset:0;z-index:1;background:radial-gradient(70% 55% at 50% 34%,rgba(8,10,13,.9) 0%,rgba(8,10,13,.45) 55%,rgba(8,10,13,0) 80%)"></div>
<div style="position:relative;z-index:2;height:100%;display:flex;flex-direction:column">
  
  <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:26px;text-align:center;padding:0 44px">
    <span style="font-size:12px;color:rgba(230,237,240,.5)">New research group · Human-centered AI</span>
    <h2 class="mh-display-104" style="margin:0;font-family:Literata,serif;font-weight:300;font-size:104px;line-height:.95;letter-spacing:-.035em;color:#F4F8FA;max-width:16ch">We model the learner, not the average.</h2>
    <p style="margin:0;font-size:17.5px;line-height:1.6;color:rgba(230,237,240,.7);max-width:58ch">Adaptive, interpretable, socially responsible systems — designed to perform and to be accountable for how they performed.</p>
    <a href="#research" style="margin-top:8px;font-size:13.5px;color:#080A0D;background:#E6EDF0;text-decoration:none;border-radius:999px;padding:15px 30px;font-weight:500">Enter the lab</a>
  </div>
  <div class="mh-gutter" style="display:flex;justify-content:space-between;align-items:flex-end;padding:26px 44px;gap:24px">
    <span style="font-size:12px;color:rgba(230,237,240,.42);max-width:30ch">The plane deforms around the cursor: a live surface, drawn from the model's own response curve.</span>
    <div class="mh-wrap" style="display:flex;gap:44px">
      <div><div style="font-family:Literata,serif;font-size:30px;color:#F4F8FA">2</div><div style="font-size:11.5px;color:rgba(230,237,240,.5);margin-top:4px">research programmes</div></div>
      <div><div style="font-family:Literata,serif;font-size:30px;color:#F4F8FA">1</div><div style="font-size:11.5px;color:rgba(230,237,240,.5);margin-top:4px">open learning resource, StatLab</div></div>
    </div>
  </div>
</div>
</div>

<div id="research" style="position:relative;padding:0;border-bottom:1px solid rgba(230,237,240,.1)">
    <div style="position:relative;height:280px;overflow:hidden">
      <mh-bg mode="lattice" speed="1" style="position:absolute;inset:0;z-index:0"></mh-bg>
      <div style="position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(6,8,10,.7) 0%,rgba(6,8,10,.35) 40%,rgba(6,8,10,.95) 100%)"></div>
      <div class="mh-gutter" style="position:relative;z-index:2;height:100%;display:flex;flex-direction:column;justify-content:flex-end;padding:44px">
        <h2 style="margin:0;font-family:Literata,serif;font-weight:300;font-size:52px;line-height:1;letter-spacing:-.025em">Research</h2>
        <p style="margin:14px 0 0;font-size:16px;color:rgba(230,237,240,.68);max-width:54ch">Two research programmes, and the publications behind them.</p>
      </div>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:minmax(0,1fr);gap:0;border-bottom:1px solid rgba(230,237,240,.1)">
    <div class="mh-gutter mh-row mh-row--full" style="display:grid;grid-template-columns:200px minmax(0,1fr);gap:40px;align-items:start;padding:40px 44px;border-bottom:1px solid rgba(230,237,240,.1)">
      <div style="font-size:12.5px;color:rgba(230,237,240,.45);line-height:1.5">Programme 01</div>
      <div style="display:flex;flex-direction:column;gap:14px">
        <h3 style="margin:0;font-family:Literata,serif;font-weight:400;font-size:30px;line-height:1.15;letter-spacing:-.015em">AI for personalised learning</h3>
        <p style="margin:0;font-size:16px;line-height:1.62;color:rgba(230,237,240,.7);max-width:60ch">Knowledge tracing: estimating what a learner has mastered, attempt by attempt, and reporting how uncertain that estimate is. The estimate is the model's claim about a person, so it is always shown with its band.</p>
        <div style="margin-top:10px">
          <div style="font-size:12px;color:rgba(230,237,240,.45);letter-spacing:.01em">Publications</div>
          <ul style="list-style:none;margin:10px 0 0;padding:0;display:flex;flex-direction:column;border-top:1px solid rgba(230,237,240,.08);max-width:64ch">
