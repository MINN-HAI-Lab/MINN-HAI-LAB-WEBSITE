---
/**
 * People, in the design canvas's language: a header band, then five 4:5
 * frames in a row with the name in the serif under each, then the hiring
 * card.
 *
 * There are no names and no photographs yet, so every frame shows its gap.
 * The hatched fill is the canvas's own placeholder; the caption inside it is
 * set in the grotesk, not the monospace the canvas used, because CLAUDE.md
 * keeps monospace for code. The canvas writes "TODO: name" under each frame;
 * here that reads "Not named yet", because a TODO on this site has to say who
 * supplies it and carry a tracker, and one marker above the row does that for
 * all five rather than five markers saying it badly.
 */
import Base from '../layouts/Base.astro';
import Field from '../components/Field.astro';
import { PEOPLE, PEOPLE_TODO, unnamedCount } from '../data/people.ts';
import { withBase } from '../lib/paths.ts';

const missing = unnamedCount();
---

<Base title="People — MINN HAI Lab" description="The people of the MINN HAI Lab.">
  <header class="band">
    <Field mode="bayes" class="band__field" />
    <div class="band__veil" aria-hidden="true"></div>
    <div class="page band__text">
      <h1 class="type-title">People</h1>
      <p class="band__lede type-body">Principal investigator, researchers, students.</p>
    </div>
  </header>

  <section class="section">
    <div class="page">
      <p class="type-body measure">
        The lab has five members.
        {
          missing === PEOPLE.length
            ? ' None of them are named here yet: the names, roles and photographs have not been supplied, and this site does not invent either.'
            : ` ${missing} of the five are not named here yet.`
        }
      </p>
      {missing > 0 && <p class="todo">{PEOPLE_TODO}</p>}

      <ul class="people">
        {
          PEOPLE.map((person, index) => (
            <li class="people__slot">
              <div
                class="people__portrait"
                role="img"
                aria-label={
                  person.name
                    ? `Portrait of ${person.name}.`
                    : `Portrait slot ${index + 1}. No photograph has been supplied.`
                }
              >
                <span class="micro people__caption" aria-hidden="true">portrait</span>
              </div>
              <p class="people__name type-name">
                {person.name ?? <span class="people__unnamed">Not named yet</span>}
              </p>
              <p class="people__role label">{person.role ?? 'Role not supplied'}</p>
              {person.todo && <p class="todo">TODO: {person.todo}</p>}
            </li>
          ))
        }
      </ul>

      <!-- The canvas's hiring card. Whether the lab is hiring is not known
           here, so the card carries the question rather than the claim. -->
      <div class="card" id="roles">
        <p class="type-name">Open roles</p>
        <p class="todo">
          TODO: whether the lab is hiring, and for what. The design canvas
          says "We are hiring research engineers"; nothing in the repository
          confirms it. docs/plan.md files an open positions section as missing.
          Kaung to supply. Tracked as B-12.
        </p>
        <p><a class="link--quiet" href={withBase('/about#join')}>How to join</a></p>
      </div>
    </div>
  </section>

  <section class="bleed group">
    <div class="group__frame" role="img" aria-label="A group photograph of the lab will appear here. It has not been supplied yet.">
      <div class="page group__todo">
        <p class="todo">
          TODO: a group photograph of the lab, landscape, at least 2400px wide.
          It sits full-bleed at the foot of this page, so faces should sit in
          the middle third — the top and bottom are cropped at wide viewports.
          Kaung to supply. Tracked as B-6.
        </p>
      </div>
    </div>
  </section>
</Base>
