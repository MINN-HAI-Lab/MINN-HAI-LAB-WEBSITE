---
/**
 * Not found. Say plainly what happened, and offer the pages that exist.
 */
import Base from '../layouts/Base.astro';
import { NAVIGATION } from '../data/navigation.ts';
import { withBase } from '../lib/paths.ts';
---

<Base title="Page not found — MINN HAI Lab" description="That page does not exist on this site." noindex>
  <section class="section">
    <div class="page">
      <h1 class="type-title">Page not found</h1>
      <p class="type-body type-muted measure">
        There is nothing at this address. It may have been a typo, or a link
        from somewhere that pointed at a page this site does not have.
      </p>
      <ul class="not-found__list">
        {
          NAVIGATION.map((item) => (
            <li>
              <a class="link" href={withBase(item.href)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
