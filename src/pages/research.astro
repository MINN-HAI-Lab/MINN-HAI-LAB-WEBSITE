---
/**
 * Research, in the design canvas's language: a header band with the lab's
 * network behind it, then one ruled row per area with the live artefact in
 * it. Two areas have publications and two do not, and the two that do not say
 * so in words, in place.
 */
import Base from '../layouts/Base.astro';
import Field from '../components/Field.astro';
import Language from '../components/Language.astro';
import Network from '../components/Network.astro';
import PublicationList from '../components/PublicationList.astro';
import Saliency from '../components/Saliency.astro';
import Trace from '../components/Trace.astro';
import { RESEARCH_AREAS } from '../data/navigation.ts';
import { byProgramme } from '../data/publications.ts';

const [tracing, bayesian, vision, language] = RESEARCH_AREAS;
const tracingPapers = byProgramme('personalised-learning');
const bayesianPapers = byProgramme('interpretability');
---

<Base
  title="Research — MINN HAI Lab"
  description="Two programmes and two directions, each with a working artefact: knowledge tracing, Bayesian explanation, computer vision and language."
>
  <header class="band">
    <Field mode="bayes" class="band__field" />
    <div class="band__veil" aria-hidden="true"></div>
    <div class="page band__text">
      <h1 class="type-title">Research</h1>
      <p class="band__lede type-body">
        Two programmes and two directions. Each ships a live artefact you can
        operate, not a figure you have to take on faith.
      </p>
    </div>
  </header>

  <section class="section" style="padding-block: 0">
    <div class="page">
      <!-- 01 -->
      <div class="row row--no-aside" id={tracing.id}>
        <p class="row__label label">Programme 01<br />Active</p>
        <div class="row__body">
          <h2 class="type-section">AI for personalised learning</h2>
          <p class="type-body type-muted measure">{tracing.line}</p>
          <ul class="tags">
            <li class="tag">Live trace widget</li>
            <li class="tag">Synthetic data, labelled</li>
          </ul>
        </div>
        <div class="row__wide area">
          <Trace />
          <div class="area__papers">
            <h3 class="type-name">Published work</h3>
            <p class="label">{tracingPapers.length} entries, most recent first.</p>
            <PublicationList publications={tracingPapers} />
          </div>
        </div>
      </div>

      <!-- 02 -->
      <div class="row row--no-aside" id={bayesian.id}>
        <p class="row__label label">Programme 02<br />Active</p>
        <div class="row__body">
          <h2 class="type-section">Interpretable explanation of tabular models</h2>
          <p class="type-body type-muted measure">{bayesian.line}</p>
          <ul class="tags">
            <li class="tag">3D blanket graph, click to load</li>
            <li class="tag">Static SVG fallback</li>
          </ul>
        </div>
        <div class="row__wide area">
          <Network />
          <div class="area__papers">
            <h3 class="type-name">Published work</h3>
            <p class="label">{bayesianPapers.length} entries, most recent first.</p>
            <PublicationList publications={bayesianPapers} />
          </div>
        </div>
      </div>

      <!-- 03 -->
      <div class="row row--no-aside" id={vision.id}>
        <p class="row__label label">Direction 03<br />No published work yet</p>
        <div class="row__body">
          <h2 class="type-section">{vision.name}</h2>
          <p class="type-body type-muted measure">{vision.line}</p>
          <ul class="tags">
            <li class="tag">Openly licensed photograph</li>
            <li class="tag">Saliency computed in the browser</li>
          </ul>
        </div>
        <div class="row__wide area">
          <Saliency />
          <div class="area__papers">
            <h3 class="type-name">Published work</h3>
            <p class="area__none type-body">
              None yet. This is a research direction rather than a programme
              with output: there are no papers in this area in the list the lab
              supplied, and none are claimed here.
            </p>
          </div>
        </div>
      </div>

      <!-- 04 -->
      <div class="row row--no-aside" id={language.id}>
        <p class="row__label label">Direction 04<br />No published work yet</p>
        <div class="row__body">
          <h2 class="type-section">{language.name}</h2>
          <p class="type-body type-muted measure">{language.line}</p>
          <ul class="tags">
            <li class="tag">Real tokenisation</li>
            <li class="tag">Illustrative attention, labelled</li>
          </ul>
        </div>
        <div class="row__wide area">
          <Language />
          <div class="area__papers">
            <h3 class="type-name">Published work</h3>
            <p class="area__none type-body">
              None yet. As with computer vision, this is a direction the lab is
              working in, not one it has published in.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
