---
/**
 * Research — the research band, then the three themes, zigzagging left and
 * right. See src/layouts/Layout.astro for the chrome and the transcription
 * notes that apply to every page.
 *
 * Supersedes D-042's three-column layout — Kaung asked for two columns per
 * theme instead, alternating text and visual side, text/visual/text down
 * the left, visual/text/visual down the right. .mh-zigzag (Layout.astro) is
 * the grid: 2 columns at 992px and up, 1 below, no canvas equivalent.
 *
 * Theme 01's visual is mh-bg mode="bayes", the network graphic that used to
 * sit in Home's Deep Field section (now removed — see index.astro), shown
 * unpanelled — no border, no background — straight on the page. Theme 02
 * and Theme 03's visuals are placeholders: Kaung named them "Image or 3D
 * object" with no asset yet, so they're marked, not invented. The header
 * band's own mh-bg (mode="lattice") is gone too, redundant once Theme 01
 * carried a real network graphic of its own.
 *
 * Theme 03, "Visual generative modeling", has a real description now
 * (Kaung's request, drafted with the personal-humanizer skill to match
 * Theme 01 and 02's voice) — its publications are still TODO:, nothing
 * supplied yet.
 */
import Layout from '../layouts/Layout.astro';
---

<Layout title="Research — MINN HAI Lab">
<div style="background:#06080A">
<div id="research" style="position:relative;padding:0;border-bottom:1px solid rgba(230,237,240,.1)">
    <div style="position:relative;height:280px;overflow:hidden">
      <div style="position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(6,8,10,.7) 0%,rgba(6,8,10,.35) 40%,rgba(6,8,10,.95) 100%)"></div>
      <div class="mh-gutter" style="position:relative;z-index:2;height:100%;display:flex;flex-direction:column;justify-content:flex-end;padding:44px">
        <h2 style="margin:0;font-family:Literata,serif;font-weight:300;font-size:52px;line-height:1;letter-spacing:-.025em">Research</h2>
        <p style="margin:14px 0 0;font-size:16px;color:rgba(230,237,240,.68);max-width:54ch">Three research themes, and the publications behind them.</p>
      </div>
    </div>
  </div>

  <div class="mh-gutter mh-zigzag" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:56px;align-items:start;padding:56px 44px;border-bottom:1px solid rgba(230,237,240,.1)">
    <div style="display:flex;flex-direction:column;gap:14px">
      <div style="font-size:12.5px;color:rgba(230,237,240,.45);line-height:1.5">Theme 01</div>
      <h3 style="margin:0;font-family:Literata,serif;font-weight:400;font-size:30px;line-height:1.15;letter-spacing:-.015em">AI for personalised learning</h3>
      <p style="margin:0;font-size:16px;line-height:1.62;color:rgba(230,237,240,.7)">Knowledge tracing: estimating what a learner has mastered, attempt by attempt, and reporting how uncertain that estimate is. The estimate is the model's claim about a person, so it is always shown with its band.</p>
      <div style="margin-top:10px">
        <div style="font-size:12px;color:rgba(230,237,240,.45);letter-spacing:.01em">Publications</div>
        <ul style="list-style:none;margin:10px 0 0;padding:0;display:flex;flex-direction:column;border-top:1px solid rgba(230,237,240,.08)">
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0;border-bottom:1px solid rgba(230,237,240,.08)"><a href="https://link.springer.com/chapter/10.1007/978-3-031-98462-4_53" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:#E6EDF0;text-decoration:none;border-bottom:1px solid rgba(230,237,240,.4)">EIKT</a><span style="font-size:12.5px;color:rgba(230,237,240,.5)">AIED, 2025</span></li>
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0;border-bottom:1px solid rgba(230,237,240,.08)"><a href="https://arxiv.org/pdf/2207.03202" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:#E6EDF0;text-decoration:none;border-bottom:1px solid rgba(230,237,240,.4)">Privacy-Preserving Synthetic Data Generation</a><span style="font-size:12.5px;color:rgba(230,237,240,.5)">EC-TEL, 2018</span></li>
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0;border-bottom:1px solid rgba(230,237,240,.08)"><a href="https://cdn.aaai.org/ojs/21560/21560-13-25573-1-2-20220628.pdf" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:#E6EDF0;text-decoration:none;border-bottom:1px solid rgba(230,237,240,.4)">IKT</a><span style="display:flex;align-items:center;gap:8px;font-size:12.5px;color:rgba(230,237,240,.5)">AAAI, 2022<a href="https://github.com/simon-tan/IKT" target="_blank" rel="noopener" style="border:1px solid rgba(230,237,240,.18);border-radius:2px;padding:2px 7px;font-size:10.5px;color:rgba(230,237,240,.62);text-decoration:none">code</a></span></li>
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0;border-bottom:1px solid rgba(230,237,240,.08)"><a href="https://arxiv.org/pdf/2012.12218" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:#E6EDF0;text-decoration:none;border-bottom:1px solid rgba(230,237,240,.4)">BKT-LSTM</a><span style="display:flex;align-items:center;gap:8px;font-size:12.5px;color:rgba(230,237,240,.5)">Arxiv, 2021<a href="https://github.com/Simon-tan/BKT-LSTM" target="_blank" rel="noopener" style="border:1px solid rgba(230,237,240,.18);border-radius:2px;padding:2px 7px;font-size:10.5px;color:rgba(230,237,240,.62);text-decoration:none">code</a></span></li>
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0;border-bottom:1px solid rgba(230,237,240,.08)"><a href="https://ink.library.smu.edu.sg/cgi/viewcontent.cgi?article=5350&amp;context=sis_research" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:#E6EDF0;text-decoration:none;border-bottom:1px solid rgba(230,237,240,.4)">DSCMN</a><span style="display:flex;align-items:center;gap:8px;font-size:12.5px;color:rgba(230,237,240,.5)">PAKDD, 2019<a href="https://github.com/Simon-tan/DSCMN" target="_blank" rel="noopener" style="border:1px solid rgba(230,237,240,.18);border-radius:2px;padding:2px 7px;font-size:10.5px;color:rgba(230,237,240,.62);text-decoration:none">code</a></span></li>
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0;border-bottom:1px solid rgba(230,237,240,.08)"><a href="https://arxiv.org/pdf/1809.08713" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:#E6EDF0;text-decoration:none;border-bottom:1px solid rgba(230,237,240,.4)">DKT-DSC</a><span style="display:flex;align-items:center;gap:8px;font-size:12.5px;color:rgba(230,237,240,.5)">ICDM, 2018<a href="https://github.com/Simon-tan/DKT-DSC" target="_blank" rel="noopener" style="border:1px solid rgba(230,237,240,.18);border-radius:2px;padding:2px 7px;font-size:10.5px;color:rgba(230,237,240,.62);text-decoration:none">code</a></span></li>
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0;border-bottom:1px solid rgba(230,237,240,.08)"><a href="https://ink.library.smu.edu.sg/cgi/viewcontent.cgi?article=5330&amp;context=sis_research" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:#E6EDF0;text-decoration:none;border-bottom:1px solid rgba(230,237,240,.4)">KT</a><span style="font-size:12.5px;color:rgba(230,237,240,.5)">ICDM, 2018</span></li>
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0;border-bottom:1px solid rgba(230,237,240,.08)"><a href="https://www.professeurs.polymtl.ca/michel.desmarais/Publications-Michel/EC-TEL_2016_paper_185.pdf" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:#E6EDF0;text-decoration:none;border-bottom:1px solid rgba(230,237,240,.4)">Q-matrix Reinment</a><span style="font-size:12.5px;color:rgba(230,237,240,.5)">EC-TEL, 2016</span></li>
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0"><a href="https://files.eric.ed.gov/fulltext/ED562315.pdf" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:#E6EDF0;text-decoration:none;border-bottom:1px solid rgba(230,237,240,.4)">Uni Library Rec. Syst.</a><span style="font-size:12.5px;color:rgba(230,237,240,.5)">e-Learning, 2013</span></li>
        </ul>
      </div>
    </div>
    <div style="position:relative;height:420px">
      <mh-bg mode="bayes" speed="1" style="position:absolute;inset:0;z-index:0"></mh-bg>
    </div>
  </div>

  <div class="mh-gutter mh-zigzag" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:56px;align-items:start;padding:56px 44px;border-bottom:1px solid rgba(230,237,240,.1)">
    <div style="border:1px solid rgba(230,237,240,.14);border-radius:3px;height:420px;background:repeating-linear-gradient(135deg,rgba(230,237,240,.05) 0 6px,transparent 6px 12px);display:flex;align-items:flex-end;padding:14px">
      <span style="font-family:ui-monospace,Menlo,monospace;font-size:10.5px;color:rgba(230,237,240,.5)">image / 3D object — placeholder</span>
    </div>
    <div style="display:flex;flex-direction:column;gap:14px">
      <div style="font-size:12.5px;color:rgba(230,237,240,.45);line-height:1.5">Theme 02</div>
      <h3 style="margin:0;font-family:Literata,serif;font-weight:400;font-size:30px;line-height:1.15;letter-spacing:-.015em">Interpretable explanation of tabular models</h3>
      <p style="margin:0;font-size:16px;line-height:1.62;color:rgba(230,237,240,.7)">Bayesian networks and Markov blankets: identifying the smallest set of variables that renders a target conditionally independent of everything else, so an explanation names variables rather than gesturing at importance scores.</p>
      <div style="margin-top:10px">
        <div style="font-size:12px;color:rgba(230,237,240,.45);letter-spacing:.01em">Publications</div>
        <ul style="list-style:none;margin:10px 0 0;padding:0;display:flex;flex-direction:column;border-top:1px solid rgba(230,237,240,.08)">
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0;border-bottom:1px solid rgba(230,237,240,.08)"><a href="https://arxiv.org/pdf/2310.00570" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:#E6EDF0;text-decoration:none;border-bottom:1px solid rgba(230,237,240,.4)">LAPLACE</a><span style="display:flex;align-items:center;gap:8px;font-size:12.5px;color:rgba(230,237,240,.5)">Arxiv, 2023<a href="https://github.com/Simon-tan/LaPLACE" target="_blank" rel="noopener" style="border:1px solid rgba(230,237,240,.18);border-radius:2px;padding:2px 7px;font-size:10.5px;color:rgba(230,237,240,.62);text-decoration:none">code</a></span></li>
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0;border-bottom:1px solid rgba(230,237,240,.08)"><a href="https://www.computer.org/csdl/proceedings-article/icdmw/2023/816400a966/1UjHSKsoytO" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:#E6EDF0;text-decoration:none;border-bottom:1px solid rgba(230,237,240,.4)">FSBN &amp; SSBN</a><span style="display:flex;align-items:center;gap:8px;font-size:12.5px;color:rgba(230,237,240,.5)">ICDM, 2023<span style="font-size:11px;color:rgba(230,237,240,.4);font-style:italic">CXAI workshop</span></span></li>
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0;border-bottom:1px solid rgba(230,237,240,.08)"><a href="https://ieeexplore.ieee.org/abstract/document/7058101" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:#E6EDF0;text-decoration:none;border-bottom:1px solid rgba(230,237,240,.4)">GBNC</a><span style="font-size:12.5px;color:rgba(230,237,240,.5)">DSAA, 2014</span></li>
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0;border-bottom:1px solid rgba(230,237,240,.08)"><a href="http://link.springer.com/chapter/10.1007/978-3-319-08979-9_2" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:#E6EDF0;text-decoration:none;border-bottom:1px solid rgba(230,237,240,.4)">GMBNC</a><span style="font-size:12.5px;color:rgba(230,237,240,.5)">MLDM, 2014</span></li>
          <li style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px;padding:10px 0"><a href="https://www.oalib.com/research/5205821" target="_blank" rel="noopener" style="font-family:Literata,serif;font-size:15px;color:#E6EDF0;text-decoration:none;border-bottom:1px solid rgba(230,237,240,.4)">MBNC</a><span style="display:flex;align-items:center;gap:8px;font-size:12.5px;color:rgba(230,237,240,.5)">Computer Science and Application, 2014<span style="font-size:11px;color:rgba(230,237,240,.4);font-style:italic">in Chinese</span></span></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="mh-gutter mh-zigzag" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:56px;align-items:start;padding:56px 44px">
    <div style="display:flex;flex-direction:column;gap:14px">
      <div style="font-size:12.5px;color:rgba(230,237,240,.45);line-height:1.5">Theme 03</div>
      <h3 style="margin:0;font-family:Literata,serif;font-weight:400;font-size:30px;line-height:1.15;letter-spacing:-.015em">Visual generative modeling</h3>
      <p style="margin:0;font-size:16px;line-height:1.62;color:rgba(230,237,240,.7)">Learning what makes an image or video plausible well enough to generate new ones, not just classify or detect what's already there. A model that can generate a scene has learned something about its structure, so generation doubles as a test of whether a system understands what it sees.</p>
      <div style="margin-top:10px">
        <div style="font-size:12px;color:rgba(230,237,240,.45);letter-spacing:.01em">Publications</div>
        <div style="border-left:3px solid rgba(230,237,240,.4);background:rgba(6,8,10,.75);border-radius:3px;padding:14px 16px;margin-top:10px;font-size:13px;line-height:1.6;color:rgba(230,237,240,.82)">TODO: publications for this theme, to be supplied.</div>
      </div>
    </div>
    <div style="border:1px solid rgba(230,237,240,.14);border-radius:3px;height:420px;background:repeating-linear-gradient(135deg,rgba(230,237,240,.05) 0 6px,transparent 6px 12px);display:flex;align-items:flex-end;padding:14px">
      <span style="font-family:ui-monospace,Menlo,monospace;font-size:10.5px;color:rgba(230,237,240,.5)">image / 3D object — placeholder</span>
    </div>
  </div>
</div>
</Layout>
