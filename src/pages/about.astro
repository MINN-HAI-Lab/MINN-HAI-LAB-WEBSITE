---
/**
 * About, in the design canvas's language. Mission, where the lab is, funding,
 * how to join, contact — each a ruled row with the label column on the left.
 *
 * The mission text is the paragraph from the canvas's direction 1b. It reads
 * as the lab's own words and it matches what docs/plan.md calls the supplied
 * mission paragraph, but it arrived through a design file rather than from
 * Kaung directly, so it is marked to be confirmed rather than assumed.
 *
 * Everything else here that is a fact about the lab — affiliation, funders,
 * address, roles — is still missing and still shown as a gap.
 */
import Base from '../layouts/Base.astro';
import Field from '../components/Field.astro';
import { LAB_NAME, RESEARCH_AREAS } from '../data/navigation.ts';
import { PUBLICATIONS } from '../data/publications.ts';
import { withBase } from '../lib/paths.ts';

const years = PUBLICATIONS.map((p) => p.year);
const earliest = Math.min(...years);
const latest = Math.max(...years);
const WORDS = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const inWords = (n: number): string => WORDS[n] ?? String(n);
---

<Base title={`About — ${LAB_NAME}`} description="What the lab works on, how it is funded, and how to get in touch.">
  <header class="band">
    <Field mode="bayes" class="band__field" />
    <div class="band__veil" aria-hidden="true"></div>
    <div class="page band__text">
      <h1 class="type-title">About</h1>
      <p class="band__lede type-body">Between human understanding and machine inference.</p>
    </div>
  </header>

  <section class="section" style="padding-block: 0">
    <div class="page">
      <div class="row row--no-aside" id="mission">
        <p class="row__label label">Mission</p>
        <div class="row__body">
          <p class="type-body measure">
            The MINN HAI Lab explores the synergy between the two — developing
            intelligent systems that are adaptive, interpretable and socially
            responsible, and that align with human values, cognitive processes
            and real-world needs.
          </p>
          <p class="type-body type-muted measure">
            {LAB_NAME} works on {inWords(RESEARCH_AREAS.length)} things:{' '}
            {RESEARCH_AREAS.map((area) => area.name).join(', ')}. Two of them
            have published work behind them, going back to {earliest} and as
            recent as {latest}; two are directions rather than programmes. The{' '}
            <a class="link" href={withBase('/research')}>research page</a> has a
            working version of each.
          </p>
          <p class="todo">
            TODO: confirm the mission paragraph above. It is the text from the
            design canvas, which reads as the lab's own, but docs/plan.md lists
            the supplied mission as a document this repository never received.
            Kaung to confirm the wording. Tracked as B-3.
          </p>
        </div>
      </div>

      <div class="row row--no-aside" id="where">
        <p class="row__label label">Where the lab is</p>
        <div class="row__body">
          <p class="todo">
            TODO: institutional affiliation. docs/plan.md lists this as blocking
            launch — a lab site that does not say which institution it belongs
            to is hard to take seriously, and guessing one would be a
            fabricated affiliation on a public academic page. Kaung to supply.
            Tracked as B-7.
          </p>
        </div>
      </div>

      <div class="row row--no-aside" id="funding">
        <p class="row__label label">Funding</p>
        <div class="row__body">
          <p class="type-body type-muted measure">
            This work is supported by grants that are not yet listed here. The
            list this site was built from gives them in an abbreviated form
            that could not be verified, and a funder credited under the wrong
            name is a third party misrepresented, not a typo.
          </p>
          <p class="todo">
            TODO: verified funder names, in full, with grant numbers where they
            should appear. The supplied list reads{' '}
            <span class="quoted">Uni Kyoto-Inria associate team grant</span> and{' '}
            <span class="quoted">Uni Library Rec. Syst.</span>, which look
            abbreviated or partially redacted. docs/plan.md says these need
            checking before publication. Kaung to supply. Tracked as B-9.
          </p>
          <p class="label">No logo wall. Funders are acknowledged in plain text, which is what most of them ask for.</p>
        </div>
      </div>

      <div class="row row--no-aside" id="join">
        <p class="row__label label">Join</p>
        <div class="row__body">
          <p class="type-body type-muted measure">
            Prospective PhD and master's students, and anyone who would work
            with the lab, start here.
          </p>
          <p class="todo">
            TODO: how to apply, and which roles are open. The design canvas
            shows an "open roles" link and a hiring card; nothing in the
            repository says whether the lab is hiring or how a student applies.
            Kaung to supply. Tracked as B-12.
          </p>
        </div>
      </div>

      <div class="row row--no-aside" id="contact">
        <p class="row__label label">Contact</p>
        <div class="row__body">
          <p class="type-body type-muted measure">
            To partner with the lab, or to bring it a problem that needs an
            explanation.
          </p>
          <p class="todo">
            TODO: the contact email address. docs/plan.md lists it as supplied
            but it is not in this repository. It appears here and in the footer
            of every page, so it only needs supplying once. Kaung to supply.
            Tracked as B-2.
          </p>
        </div>
      </div>

      <div class="row row--no-aside" id="site">
        <p class="row__label label">About this site</p>
        <div class="row__body">
          <p class="type-body type-muted measure">
            Every publication on this site comes from a list the lab supplied,
            and nothing has been added to it. Where a field is missing —
            authors, links, a name, a photograph — the page says so rather than
            filling it with something plausible. The{' '}
            {inWords(RESEARCH_AREAS.length)} artefacts on the research page each
            state whether what they show is real, synthetic or illustrative.
          </p>
          <p class="label">
            A static site: no tracking, no analytics, no cookies, no fonts or
            scripts loaded from anywhere else.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
